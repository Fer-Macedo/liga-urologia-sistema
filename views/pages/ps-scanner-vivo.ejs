<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>Correção ao Vivo — LAURO</title>
  <style>
    :root{--cor:<%= config.org_cor||'#2b6803' %>;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:#000;color:#fff;font-family:system-ui,-apple-system,Arial,sans-serif;overflow:hidden;height:100vh;}
    .top{position:fixed;top:0;left:0;right:0;z-index:10;background:rgba(15,23,42,.85);padding:10px 14px;display:flex;align-items:center;gap:10px;}
    .top a{color:#fff;text-decoration:none;font-size:22px;line-height:1;}
    .top .info{flex:1;font-size:13px;font-weight:700;}
    .stage{position:relative;width:100vw;height:100vh;background:#000;}
    video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000;}
    canvas#ov{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}
    .hint{position:fixed;bottom:88px;left:0;right:0;text-align:center;font-size:15px;font-weight:700;color:#fbbf24;text-shadow:0 1px 4px #000;padding:0 16px;}
    .bar{position:fixed;bottom:0;left:0;right:0;z-index:10;background:rgba(15,23,42,.92);padding:12px 14px;display:flex;gap:12px;align-items:center;}
    .res{flex:1;font-size:14px;line-height:1.3;}
    .res .big{font-size:22px;font-weight:900;}
    .btn{padding:14px 18px;border:none;border-radius:8px;background:var(--cor);color:#fff;font-size:15px;font-weight:800;}
    .btn:disabled{opacity:.45;}
    .badge{padding:3px 10px;border-radius:20px;font-weight:800;font-size:11px;vertical-align:middle;}
    .ap{background:#16a34a;} .re{background:#dc2626;}
    .msg{position:fixed;top:52px;left:0;right:0;text-align:center;font-size:13px;color:#86efac;font-weight:700;display:none;}
  </style>
</head>
<body>
  <div class="top"><a href="/processo-seletivo/<%=processo.id%>/scanner">&#8592;</a><div class="info">Correção ao Vivo — <%=processo.nome%></div></div>
  <div class="stage"><video id="v" playsinline muted></video><canvas id="ov"></canvas></div>
  <div class="msg" id="msg"></div>
  <div class="hint" id="hint">Iniciando câmera…</div>
  <div class="bar">
    <div class="res" id="res"><span style="color:#94a3b8">Aponte a câmera para o cartão</span></div>
    <button class="btn" id="btnConf" disabled>✅ Confirmar</button>
  </div>
<script>
var PROCID=<%=processo.id%>, URLV='/processo-seletivo/'+PROCID+'/scan-vivo';
var v=document.getElementById('v'), ov=document.getElementById('ov'), octx=ov.getContext('2d');
var off=document.createElement('canvas'), offc=off.getContext('2d');
var busy=false, ultimo=null;
navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'}},audio:false})
 .then(function(s){ v.srcObject=s; v.play(); document.getElementById('hint').textContent='Alinhe o cartão inteiro no quadro (com os quadradinhos das laterais)'; loop(); })
 .catch(function(e){ document.getElementById('hint').textContent='Não consegui abrir a câmera: '+e.message; });
function loop(){ if(parado) return; setTimeout(tick, 700); }
function tick(){
  if(parado){ return; }
  if(busy){ loop(); return; }
  var vw=v.videoWidth, vh=v.videoHeight;
  if(!vw){ loop(); return; }
  var w=800, h=Math.round(vh*w/vw); off.width=w; off.height=h; offc.drawImage(v,0,0,w,h);
  off.toBlob(function(b){ if(!b){ busy=false; loop(); return; }
    var fd=new FormData(); fd.append('imagem', b, 'f.jpg'); busy=true;
    fetch(URLV,{method:'POST',body:fd,credentials:'same-origin'})
      .then(function(r){return r.json();})
      .then(function(d){ busy=false; render(d); loop(); })
      .catch(function(){ busy=false; loop(); });
  },'image/jpeg',0.6);
}
function render(d){
  var hint=document.getElementById('hint'), res=document.getElementById('res'), btn=document.getElementById('btnConf');
  octx.clearRect(0,0,ov.width,ov.height);
  if(!d || !d.ok || !d.detectado){ hint.style.display=''; hint.textContent=(d&&d.motivo)||'Alinhe o cartão inteiro no quadro'; btn.disabled=true; return; }
  hint.style.display='none';
  var rect=v.getBoundingClientRect();
  if(ov.width!==Math.round(rect.width)) ov.width=Math.round(rect.width);
  if(ov.height!==Math.round(rect.height)) ov.height=Math.round(rect.height);
  var sx=ov.width/d.W, sy=ov.height/d.H;
  (d.itens||[]).forEach(function(it){
    octx.beginPath(); octx.arc(it.x*sx, it.y*sy, Math.max(9, it.r*sx*1.15), 0, 6.2832);
    octx.lineWidth=3.5; octx.strokeStyle=(it.status==='correta')?'#22c55e':'#ef4444'; octx.stroke();
  });
  var ap=d.percentual>=d.nota_minima;
  var nome=d.candidato ? ('#'+String(d.candidato.numero_lista||'?').padStart(3,'0')+' '+d.candidato.nome) : ('Registro '+(d.numero_registro_lido||'?')+' — não cadastrado');
  res.innerHTML='<div class="big">'+d.acertos+'/'+d.total_questoes+' <span class="badge '+(ap?'ap':'re')+'">'+(ap?'CLASSIFICADO':'REPROVADO')+'</span></div><div style="font-size:12px;color:#cbd5e1">'+nome+' · Fila '+d.fila+'</div>';
  ultimo=d; btn.disabled=!d.candidato;
}
var parado=false;
document.getElementById('btnConf').addEventListener('click',function(){
  if(!ultimo || !ultimo.candidato){ return; }
  var btn=this; btn.disabled=true; parado=true; btn.textContent='Capturando…';
  // Captura um quadro em boa resolucao e passa pelo MESMO fluxo da correcao por foto
  // (guarda a foto do cartao + le + identifica), depois lanca. Assim os dois modos ficam iguais.
  var vw=v.videoWidth, vh=v.videoHeight, w=Math.min(1500, vw), h=Math.round(vh*w/vw);
  off.width=w; off.height=h; offc.drawImage(v,0,0,w,h);
  off.toBlob(function(b){
    if(!b){ btn.textContent='Erro na captura'; btn.disabled=false; parado=false; loop(); return; }
    var fd=new FormData(); fd.append('imagem', b, 'cartao.jpg');
    fetch('/processo-seletivo/'+PROCID+'/scan',{method:'POST',body:fd,credentials:'same-origin'})
      .then(function(r){return r.json();}).then(function(d){
        if(!d.ok || !d.candidato){ btn.textContent='Não identificou — ajuste e tente de novo'; btn.disabled=false; parado=false; loop(); return; }
        var RESP={}; for(var i=1;i<=d.total_questoes;i++){ RESP[i]=d.respostas[i]?String(d.respostas[i]).toUpperCase():null; }
        btn.textContent='Lançando…';
        fetch('/processo-seletivo/candidato/'+d.candidato.id+'/correcao',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({respostas_json:JSON.stringify(RESP),total_questoes:d.total_questoes,total_acertos:d.acertos,percentual:d.percentual,prova_id:d.prova_id,cartao_chave:d.cartao_chave})})
        .then(function(r){return r.json();}).then(function(x){
          if(x.ok){ var m=document.getElementById('msg'); m.style.display='block'; m.textContent='✅ Lançado! '+(x.aprovado?'CLASSIFICADO':'REPROVADO')+' ('+x.percentual+'%) — foto do cartão salva.'; btn.textContent='✅ Lançado'; setTimeout(function(){ location.href='/processo-seletivo'; }, 1800); }
          else { btn.textContent='Erro ao lançar'; btn.disabled=false; parado=false; loop(); }
        }).catch(function(){ btn.textContent='Erro de rede'; btn.disabled=false; parado=false; loop(); });
      }).catch(function(){ btn.textContent='Erro de rede'; btn.disabled=false; parado=false; loop(); });
  },'image/jpeg',0.85);
});
</script>
</body>
</html>
