// Mostra o resultado do envio (msg) + link "Ver detalhes" com uma tabela de quem recebeu por
// WhatsApp/e-mail e quem falhou — antes não tinha nenhuma visibilidade disso.
function mostrarResultadoLinksLive(elId, d) {
  const el = document.getElementById(elId);
  if (!d.ok) { el.textContent = 'Erro: ' + (d.msg || 'falha'); return; }
  el.innerHTML = escHtmlLive(d.msg || 'Concluído.');
  if (d.logs && d.logs.length) {
    const btn = document.createElement('a');
    btn.href = 'javascript:void(0)';
    btn.textContent = ' Ver detalhes (quem recebeu)';
    btn.style.cssText = 'color:#5eead4;text-decoration:underline;margin-left:6px;cursor:pointer';
    btn.onclick = () => abrirDetalhesLinksLive(d.logs);
    el.appendChild(btn);
  }
}
function escHtmlLive(s){ var d=document.createElement('div'); d.textContent=s||''; return d.innerHTML; }
function abrirDetalhesLinksLive(logs) {
  const rotulo = { enviado: 'Enviado', falhou: 'Falhou', sem_whatsapp: 'Sem WhatsApp', sem_email: 'Sem e-mail' };
  const cor = { enviado: '#166534', falhou: '#991b1b', sem_whatsapp: '#94a3b8', sem_email: '#94a3b8' };
  const w = window.open('', '_blank', 'width=760,height=520');
  w.document.write('<html><head><title>Envio do link da aula</title><style>body{font-family:Arial;padding:20px}table{width:100%;border-collapse:collapse}th,td{padding:8px 12px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}th{background:#f8fafc;font-size:12px}</style></head><body><h3>Quem recebeu o link</h3><table><thead><tr><th>Nome</th><th>E-mail</th><th>WhatsApp</th><th>E-mail (canal)</th></tr></thead><tbody>'
    + logs.map(l => '<tr><td>'+escHtmlLive(l.nome)+'</td><td>'+escHtmlLive(l.email)+'</td>'
      + '<td style="color:'+cor[l.wppStatus]+'">'+rotulo[l.wppStatus]+'</td>'
      + '<td style="color:'+cor[l.emailStatus]+'">'+rotulo[l.emailStatus]+'</td></tr>').join('')
    + '</tbody></table></body></html>');
  w.document.close();
}
