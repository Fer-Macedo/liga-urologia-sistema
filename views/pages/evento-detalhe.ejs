function filtrarCupons(){
  var b=(document.getElementById('cup-busca')?document.getElementById('cup-busca').value:'').toLowerCase();
  var sit=document.getElementById('cup-situacao')?document.getElementById('cup-situacao').value:'';
  var crDe=document.getElementById('cup-cr-de')?document.getElementById('cup-cr-de').value:'';
  var crAte=document.getElementById('cup-cr-ate')?document.getElementById('cup-cr-ate').value:'';
  var usDe=document.getElementById('cup-us-de')?document.getElementById('cup-us-de').value:'';
  var usAte=document.getElementById('cup-us-ate')?document.getElementById('cup-us-ate').value:'';
  _cupFilt=Array.prototype.slice.call(document.querySelectorAll('.cup-row')).filter(function(rr){
    if(b && (rr.dataset.busca||'').indexOf(b)<0) return false;
    if(sit && rr.dataset.usado!==sit) return false;
    var dc=rr.dataset.criado||'';
    if(crDe && (!dc||dc<crDe)) return false;
    if(crAte && (!dc||dc>crAte)) return false;
    var du=rr.dataset.uso||'';
    if(usDe && (!du||du<usDe)) return false;
    if(usAte && (!du||du>usAte)) return false;
    return true;
  });
  _cupPag=1; renderCup();
}
var _cupPag=1,_cupFilt=[];
function renderCup(){
  var pp=25, total=_cupFilt.length, totalP=Math.ceil(total/pp)||1;
  if(_cupPag>totalP)_cupPag=totalP;
  var ini=(_cupPag-1)*pp, fim=ini+pp;
  document.querySelectorAll('.cup-row').forEach(function(rr){rr.style.display='none';});
  _cupFilt.forEach(function(rr,i){rr.style.display=(i>=ini&&i<fim)?'':'none';});
  var cc=document.getElementById('cup-count'); if(cc)cc.textContent=total;
  var pi=document.getElementById('cup-paginacao'); if(!pi)return;
  var bs='display:inline-flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 8px;border-radius:3px;border:1px solid var(--borda);background:var(--card);color:var(--texto2);font-size:12px;font-weight:600;cursor:pointer;';
  var ba='display:inline-flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 8px;border-radius:3px;border:1px solid var(--cor-primaria);background:var(--cor-primaria);color:#fff;font-size:12px;font-weight:700;cursor:pointer;';
  var h='<button type=\"button\" onclick=\"cupPag(-1)\" style=\"'+bs+'\" '+(_cupPag<=1?'disabled':'')+'>&#8592;</button>';
  var start=Math.max(1,_cupPag-2),end=Math.min(totalP,start+4); if(end-start<4)start=Math.max(1,end-4);
  if(start>1){h+='<button type=\"button\" onclick=\"cupNum(1)\" style=\"'+bs+'\">1</button>'; if(start>2)h+='<span style=\"padding:0 4px;color:var(--texto2)\">...</span>';}
  for(var p=start;p<=end;p++)h+='<button type=\"button\" onclick=\"cupNum('+p+')\" style=\"'+(_cupPag===p?ba:bs)+'\">'+p+'</button>';
  if(end<totalP){if(end<totalP-1)h+='<span style=\"padding:0 4px;color:var(--texto2)\">...</span>';h+='<button type=\"button\" onclick=\"cupNum('+totalP+')\" style=\"'+bs+'\">'+totalP+'</button>';}
  h+='<button type=\"button\" onclick=\"cupPag(1)\" style=\"'+bs+'\" '+(_cupPag>=totalP?'disabled':'')+'>&#8594;</button>';
  pi.innerHTML=h;
}
function cupNum(n){var tp=Math.ceil(_cupFilt.length/25)||1;_cupPag=Math.max(1,Math.min(tp,n));renderCup();}
function cupPag(d){cupNum(_cupPag+d);}
function limparCup(){['cup-busca','cup-situacao','cup-cr-de','cup-cr-ate','cup-us-de','cup-us-ate'].forEach(function(id){var e=document.getElementById(id); if(e)e.value='';});filtrarCupons();}
function toTitleCase(s){ return s?s.toLowerCase().replace(/(^|[\s\-])(\S)/g,function(m,a,b){return a+b.toUpperCase();}):''; }
function desfazerCheckoutDia(inscricaoId, diaId, btn){
  confirmarAcao('Remover o check-out desse dia? A avaliação respondida naquele dia também é apagada.', function(){
    btn.disabled=true;
    fetch('/eventos/<%= evento.id %>/inscricao/'+inscricaoId+'/desfazer-checkout',{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ programacao_id: diaId })
    })
      .then(function(r){return r.json();})
      .then(function(d){
        if(d.ok){ carregarRelatorioCheckout(); }
        else { alert('Erro: '+(d.erro||'falha')); btn.disabled=false; }
      })
      .catch(function(e){ alert('Erro: '+e.message); btn.disabled=false; });
  });
}
document.addEventListener('DOMContentLoaded',function(){ var ck=document.getElementById('tab-checkout'); if(ck&&ck.classList.contains('ativo')) carregarRelatorioCheckout(); });
// 18/08/2026: pedido do usuário — o relatório inteiro (aptos + não fizeram check-out + sem
// inscrição) ficava tudo empilhado, uma "folha corrida" enorme. Agora só UMA dessas 3 listas
// fica visível por vez, trocada por abas (ou clicando direto no quadradinho de resumo) — o
// filtro por dia continua valendo só pra Aptos, que é a única lista organizada por dia.
var _ckView = 'aptos';
function carregarRelatorioCheckout(){
  var resumo = document.getElementById('ck-resumo');
  var rel = document.getElementById('ck-relatorio');
  rel.innerHTML = 'Carregando...';
  fetch('/eventos/<%= evento.id %>/checkout-relatorio')
    .then(function(r){return r.json();})
    .then(function(d){
      if(!d.ok){ rel.innerHTML = '<span style="color:#991b1b">Erro: '+(d.erro||'falha')+'</span>'; return; }
      _ckAptos = d.aptos || [];
      var box = function(num,lab,cor,view){ return '<div'+(view?' onclick="mostrarViewCheckout(\''+view+'\')" title="Ver lista"':'')+' style="flex:1;min-width:120px;background:'+cor+';border-radius:10px;padding:14px 16px;text-align:center'+(view?';cursor:pointer':'')+'"><div style="font-size:26px;font-weight:800;color:#0f172a">'+num+'</div><div style="font-size:11px;color:#475569;text-transform:uppercase;letter-spacing:.5px;font-weight:600">'+lab+'</div></div>'; };
      resumo.innerHTML = box(d.resumo.aptos,'Aptos','#dcfce7','aptos') + box(d.resumo.nao_compareceu,'Não compareceram','#fef3c7','naoCompareceu') + box(d.resumo.sem_inscricao,'Sem inscrição','#fee2e2','semInscricao') + box(d.resumo.total_checkouts,'Total check-outs','#e0e7ff',null);

      var abas = [
        { id: 'aptos', label: 'Aptos ao certificado', n: d.aptos.length },
        { id: 'naoCompareceu', label: 'Não fizeram check-out', n: d.naoCompareceu.length },
        { id: 'semInscricao', label: 'Sem inscrição válida', n: d.semInscricao.length }
      ];
      if(!abas.some(function(a){ return a.id === _ckView; })) _ckView = 'aptos';
      var html = '<div id="ckAbas" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">';
      abas.forEach(function(a){
        var ativo = a.id === _ckView;
        html += '<button type="button" onclick="mostrarViewCheckout(\''+a.id+'\')" id="ckAba_'+a.id+'" class="btn-xs" style="border:1px solid var(--borda);'+(ativo?'background:var(--cor-primaria);color:#fff':'background:var(--fundo);color:var(--texto2)')+'">'+a.label+' ('+a.n+')</button>';
      });
      html += '</div>';

      // APTOS — com filtro por dia (pedido do usuário 17/08/2026, 3ª rodada: saber de qual dia
      // é cada check-out, já que a mesma pessoa pode ter um check-out por dia do evento)
      html += '<div id="ckView_aptos" style="display:'+(_ckView==='aptos'?'block':'none')+'">';
      if(d.porDia && d.porDia.length){
        html += '<table class="tabela" style="width:100%;font-size:12px;margin-bottom:14px"><thead><tr><th style="text-align:left">Dia</th><th>Check-outs</th></tr></thead><tbody>';
        d.porDia.forEach(function(dia){
          var dataFmt = dia.data ? new Date(dia.data).toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit',timeZone:'UTC'}) : '';
          html += '<tr><td>'+dataFmt+' — '+dia.titulo+'</td><td style="text-align:center;font-weight:700">'+dia.total+'</td></tr>';
        });
        html += '</tbody></table>';
      }
      html += '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px">';
      html += '<input type="text" id="ckBuscaNome" class="input" style="max-width:240px" placeholder="Buscar por nome ou e-mail..." oninput="buscarAptos()">';
      if(d.porDia && d.porDia.length){
        html += '<select id="ckFiltroDia" class="input" style="max-width:280px" onchange="buscarAptos()"><option value="">Todos os dias</option>';
        d.porDia.forEach(function(dia){
          var dataFmt = dia.data ? new Date(dia.data).toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit',timeZone:'UTC'}) : '';
          var label = dia.titulo+' — '+dataFmt;
          html += '<option value="'+escHtml(label)+'">'+escHtml(label)+'</option>';
        });
        html += '</select>';
      }
      html += '</div>';
      html += '<div id="ckAptosWrap"></div>';
      html += '</div>';

      // NÃO COMPARECEU
      html += '<div id="ckView_naoCompareceu" style="display:'+(_ckView==='naoCompareceu'?'block':'none')+'">';
      if(d.naoCompareceu.length){
        html += '<table class="tabela" style="width:100%;font-size:12px"><thead><tr><th style="text-align:left">Nome</th><th style="text-align:left">Email</th></tr></thead><tbody>';
        d.naoCompareceu.forEach(function(a){ html += '<tr><td>'+toTitleCase(a.nome)+'</td><td>'+a.email+'</td></tr>'; });
        html += '</tbody></table>';
      } else { html += '<div style="color:#94a3b8;font-size:12px">Todos os inscritos confirmaram presença.</div>'; }
      html += '</div>';

      // SEM INSCRIÇÃO
      html += '<div id="ckView_semInscricao" style="display:'+(_ckView==='semInscricao'?'block':'none')+'">';
      if(d.semInscricao.length){
        html += '<div style="font-size:11px;color:#94a3b8;margin-bottom:6px">Fizeram check-out mas não foram encontrados na lista de inscritos confirmados — revisar manualmente.</div>';
        html += '<table class="tabela" style="width:100%;font-size:12px"><thead><tr><th style="text-align:left">Email informado</th><th style="text-align:left">CPF</th></tr></thead><tbody>';
        d.semInscricao.forEach(function(a){ html += '<tr><td>'+a.email+'</td><td>'+(a.cpf||'')+'</td></tr>'; });
        html += '</tbody></table>';
      } else { html += '<div style="color:#94a3b8;font-size:12px">Nenhum check-out sem inscrição válida.</div>'; }
      html += '</div>';

      rel.innerHTML = html;
      renderizarAptos();
      renderizarAvaliacao(d.perguntas, d.avaliacaoPorDia);
    })
    .catch(function(e){ rel.innerHTML = '<span style="color:#991b1b">Erro: '+e.message+'</span>'; });
}
function mostrarViewCheckout(view){
  _ckView = view;
  ['aptos','naoCompareceu','semInscricao'].forEach(function(v){
    var bloco = document.getElementById('ckView_'+v);
    if(bloco) bloco.style.display = (v===view ? 'block' : 'none');
    var aba = document.getElementById('ckAba_'+v);
    if(aba) aba.style.cssText = 'border:1px solid var(--borda);'+(v===view ? 'background:var(--cor-primaria);color:#fff' : 'background:var(--fundo);color:var(--texto2)');
  });
}
function escHtml(s){ var d=document.createElement('div'); d.textContent=s||''; return d.innerHTML; }

// Paginação genérica (25/página) — pedido do usuário 17/08/2026: check-out e avaliação
// acumulam nomes rápido (evento de vários dias), a lista ficava enorme e cansativa de rolar/
// procurar depois de encerrar o check-out de cada dia. onclickPrefix já vem com tudo que falta
// antes do número da página no onclick (ex: "irParaPaginaAptos(" ou "irParaPaginaAval(2,").
function paginacaoBotoesHtml(paginaAtual, totalItens, porPagina, onclickPrefix){
  var totalP = Math.ceil(totalItens / porPagina) || 1;
  if(totalP <= 1) return '';
  var bs = 'display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:28px;padding:0 7px;border-radius:3px;border:1px solid var(--borda);background:var(--card);color:var(--texto2);font-size:11px;font-weight:600;cursor:pointer;';
  var ba = 'display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:28px;padding:0 7px;border-radius:3px;border:1px solid var(--cor-primaria);background:var(--cor-primaria);color:#fff;font-size:11px;font-weight:700;cursor:pointer;';
  var btn = function(p, label, ativo, desativado){ return '<button onclick="'+onclickPrefix+p+')" style="'+(ativo?ba:bs)+'" '+(desativado?'disabled':'')+'>'+label+'</button>'; };
  var h = '<div style="display:flex;gap:4px;align-items:center;margin-top:10px;flex-wrap:wrap">';
  h += btn(paginaAtual-1, '&#8592;', false, paginaAtual<=1);
  var start = Math.max(1, paginaAtual-2), end = Math.min(totalP, start+4);
  if (end-start<4) start = Math.max(1, end-4);
  if (start>1) { h += btn(1,'1',false,false); if (start>2) h += '<span style="padding:0 4px;color:var(--texto2)">...</span>'; }
  for (var p=start; p<=end; p++) h += btn(p, String(p), paginaAtual===p, false);
  if (end<totalP) { if (end<totalP-1) h += '<span style="padding:0 4px;color:var(--texto2)">...</span>'; h += btn(totalP,String(totalP),false,false); }
  h += btn(paginaAtual+1, '&#8594;', false, paginaAtual>=totalP);
  h += '</div>';
  return h;
}

var _ckAptos = [];
var _ckPagina = 1;
var CK_POR_PAGINA = 25;
function buscarAptos(){ _ckPagina = 1; renderizarAptos(); }
function irParaPaginaAptos(n){ _ckPagina = n; renderizarAptos(); }
// Cada dia vira um "chip" com seu próprio × — pedido do usuário 17/08/2026 (4ª rodada): remover
// tinha que ser por dia específico, não apagar de uma vez todos os check-outs da pessoa.
function renderizarAptos(){
  var wrap = document.getElementById('ckAptosWrap');
  if(!wrap) return;
  var sel = document.getElementById('ckFiltroDia');
  var filtroDia = sel ? sel.value : '';
  var buscaEl = document.getElementById('ckBuscaNome');
  var busca = buscaEl ? buscaEl.value.trim().toLowerCase() : '';
  var lista = _ckAptos.filter(function(a){
    if(filtroDia && !(a.dias||[]).some(function(d){ return d.label === filtroDia; })) return false;
    if(busca && (a.nome||'').toLowerCase().indexOf(busca) < 0 && (a.email||'').toLowerCase().indexOf(busca) < 0) return false;
    return true;
  });
  if(!lista.length){ wrap.innerHTML = '<div style="color:#94a3b8;font-size:12px">Ninguém apto '+((filtroDia||busca)?'com esse filtro.':'ainda.')+'</div>'; return; }
  var totalP = Math.ceil(lista.length / CK_POR_PAGINA) || 1;
  if(_ckPagina > totalP) _ckPagina = totalP;
  var ini = (_ckPagina-1)*CK_POR_PAGINA, fim = ini+CK_POR_PAGINA;
  var pagina = lista.slice(ini, fim);
  var html = '<div style="font-size:11px;color:var(--texto2);margin-bottom:6px">Exibindo '+(ini+1)+'–'+Math.min(fim,lista.length)+' de '+lista.length+'</div>';
  html += '<table class="tabela" style="width:100%;font-size:12px"><thead><tr><th style="text-align:left">Nome</th><th style="text-align:left">Email</th><th>Tipo</th><th style="text-align:left">Dia(s) — × desfaz só aquele dia</th></tr></thead><tbody>';
  pagina.forEach(function(a){
    var diasDaLinha = filtroDia ? (a.dias||[]).filter(function(d){ return d.label === filtroDia; }) : (a.dias||[]);
    var chips = diasDaLinha.map(function(d){
      var diaArg = d.programacao_id === null ? 'null' : d.programacao_id;
      return '<span style="display:inline-flex;align-items:center;gap:4px;background:var(--fundo);border:1px solid var(--borda);border-radius:12px;padding:2px 4px 2px 9px;margin:2px 4px 2px 0;font-size:11px">'
        + escHtml(d.label)
        + '<button onclick="desfazerCheckoutDia('+a.id+','+diaArg+',this)" title="Remover check-out desse dia" style="background:#ef4444;color:#fff;border:none;border-radius:50%;width:15px;height:15px;line-height:14px;text-align:center;cursor:pointer;font-size:10px;padding:0">×</button></span>';
    }).join('');
    html += '<tr><td>'+toTitleCase(a.nome)+'</td><td>'+a.email+'</td><td style="text-align:center">'+(a.isento?'Isento':'Pago')+'</td><td>'+chips+'</td></tr>';
  });
  html += '</tbody></table>';
  html += paginacaoBotoesHtml(_ckPagina, lista.length, CK_POR_PAGINA, 'irParaPaginaAptos(');
  wrap.innerHTML = html;
}
var _avalCharts = {};
var _avalPerguntas = [];
var _avalDados = []; // cache por dia, pro filtro de cada dia não precisar buscar de novo
var _avalDiaAtivo = 0;
var _avalDiasRenderizados = {}; // gráficos só são criados na hora em que o dia é aberto (accordion)
var AVAL_LABELS = ['Péssimo','Ruim','Regular','Bom','Muito bom','Excelente'];
var AVAL_CORES = ['#ef4444','#f97316','#f59e0b','#84cc16','#22c55e','#15803d'];
// A avaliação é obrigatória em TODO dia do evento (pedido do usuário 17/08/2026). Antes as
// seções de todos os dias ficavam empilhadas de uma vez — pedido do usuário 18/08/2026:
// organizar como accordion (uma aba por dia), só o dia selecionado fica visível.
function renderizarAvaliacao(perguntas, avaliacaoPorDia){
  var el = document.getElementById('ck-avaliacao');
  if(!avaliacaoPorDia || !avaliacaoPorDia.length){ el.innerHTML = '<div style="color:#94a3b8;font-size:12px">Ainda não há check-outs registrados.</div>'; return; }
  _avalPerguntas = perguntas || [];
  _avalDados = avaliacaoPorDia;
  _avalDiasRenderizados = {};
  if(_avalDiaAtivo >= avaliacaoPorDia.length) _avalDiaAtivo = 0;

  var html = '<div id="avalAbas" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">';
  avaliacaoPorDia.forEach(function(dia, di){
    var dataFmt = dia.data ? new Date(dia.data).toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit',timeZone:'UTC'})+' — ' : '';
    var ativo = di === _avalDiaAtivo;
    html += '<button type="button" onclick="mostrarDiaAvaliacao('+di+')" id="avalAba_'+di+'" class="btn-xs" style="border:1px solid var(--borda);'+(ativo?'background:var(--cor-primaria);color:#fff':'background:var(--fundo);color:var(--texto2)')+'">'+dataFmt+escHtml(dia.titulo||'Dia '+(di+1))+' ('+dia.respondidas+'/'+dia.total+')</button>';
  });
  html += '</div>';

  avaliacaoPorDia.forEach(function(dia, di){
    var ativo = di === _avalDiaAtivo;
    html += '<div id="avalBloco_'+di+'" style="display:'+(ativo?'block':'none')+'">';
    html += '<div style="margin-bottom:12px;font-size:13px"><strong>'+dia.respondidas+'</strong> de <strong>'+dia.total+'</strong> responderam a avaliação desse dia (<strong>'+dia.percentual+'%</strong>).</div>';
    if(dia.respondidas === 0){
      html += '<div style="color:#94a3b8;font-size:12px">Nenhuma resposta ainda.</div></div>';
      return;
    }
    html += '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-bottom:16px">';
    perguntas.forEach(function(titulo, pi){ html += '<div><div style="font-size:12px;font-weight:600;color:#374151;margin-bottom:6px">'+escHtml(titulo)+'</div><canvas id="chartAval_'+di+'_'+pi+'" height="140"></canvas></div>'; });
    html += '</div>';
    if(dia.sugestoes && dia.sugestoes.length){
      html += '<h4 style="font-size:12px;color:#0f172a;margin:12px 0 6px">Sugestões ('+dia.sugestoes.length+')</h4>';
      html += '<div style="max-height:180px;overflow-y:auto;display:flex;flex-direction:column;gap:6px;margin-bottom:14px">';
      dia.sugestoes.forEach(function(s){ html += '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:8px 12px;font-size:12px;color:#374151">'+escHtml(s)+'</div>'; });
      html += '</div>';
    }
    html += '<input type="text" id="avalFiltro_'+di+'" class="input" placeholder="Filtrar por nome, e-mail ou sugestão..." style="margin-bottom:8px;font-size:13px" oninput="buscarAvaliacoes('+di+')">';
    html += '<div id="avalTabelaWrap_'+di+'" style="overflow-x:auto"></div>';
    html += '</div>';
  });
  el.innerHTML = html;
  mostrarDiaAvaliacao(_avalDiaAtivo);
}
function mostrarDiaAvaliacao(di){
  _avalDiaAtivo = di;
  _avalDados.forEach(function(_dia, i){
    var bloco = document.getElementById('avalBloco_'+i);
    if(bloco) bloco.style.display = (i===di ? 'block' : 'none');
    var aba = document.getElementById('avalAba_'+i);
    if(aba) aba.style.cssText = 'border:1px solid var(--borda);'+(i===di ? 'background:var(--cor-primaria);color:#fff' : 'background:var(--fundo);color:var(--texto2)');
  });
  // gráficos só são criados quando o dia é aberto pela 1ª vez — canvas escondido (display:none)
  // não tem largura pra desenhar, então não adianta criar todos de uma vez com o accordion.
  if(_avalDiasRenderizados[di] || !_avalDados[di] || !_avalDados[di].respondidas) { filtrarAvaliacoes(di); return; }
  _avalDiasRenderizados[di] = true;
  _avalPerguntas.forEach(function(titulo, pi){
    var ctxId = 'chartAval_'+di+'_'+pi;
    var canvas = document.getElementById(ctxId);
    if(!canvas) return;
    if(_avalCharts[ctxId]) _avalCharts[ctxId].destroy();
    _avalCharts[ctxId] = new Chart(canvas, {
      type: 'bar',
      data: { labels: AVAL_LABELS, datasets: [{ data: _avalDados[di].distribuicoes[pi], backgroundColor: AVAL_CORES }] },
      options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { ticks: { font: { size: 9 } } } } }
    });
  });
  filtrarAvaliacoes(di);
}
var _avalPaginas = {}; // di -> página atual
var AVAL_POR_PAGINA = 25;
function buscarAvaliacoes(di){ _avalPaginas[di] = 1; filtrarAvaliacoes(di); }
function irParaPaginaAval(di, n){ _avalPaginas[di] = n; filtrarAvaliacoes(di); }
function filtrarAvaliacoes(di){
  var wrap = document.getElementById('avalTabelaWrap_'+di);
  var dia = _avalDados[di];
  if(!wrap || !dia) return;
  var q = (document.getElementById('avalFiltro_'+di) ? document.getElementById('avalFiltro_'+di).value : '').toLowerCase();
  var filtradas = dia.respostas.filter(function(r){
    if(!q) return true;
    return (r.nome||'').toLowerCase().includes(q) || (r.email||'').toLowerCase().includes(q) || (r.sugestao||'').toLowerCase().includes(q);
  });
  var paginaAtual = _avalPaginas[di] || 1;
  var totalP = Math.ceil(filtradas.length / AVAL_POR_PAGINA) || 1;
  if(paginaAtual > totalP) paginaAtual = totalP;
  _avalPaginas[di] = paginaAtual;
  var ini = (paginaAtual-1)*AVAL_POR_PAGINA, fim = ini+AVAL_POR_PAGINA;
  var pagina = filtradas.slice(ini, fim);
  var html = '<div style="font-size:11px;color:var(--texto2);margin-bottom:6px">Exibindo '+(filtradas.length?(ini+1):0)+'–'+Math.min(fim,filtradas.length)+' de '+filtradas.length+'</div>';
  html += '<table class="tabela" style="width:100%;font-size:12px"><thead><tr><th style="text-align:left">Nome</th><th style="text-align:left">Email</th>';
  _avalPerguntas.forEach(function(p){ html += '<th>'+escHtml(p.length > 24 ? p.slice(0,24)+'…' : p)+'</th>'; });
  html += '<th style="text-align:left">Sugestão</th></tr></thead><tbody>';
  if(!filtradas.length){ html += '<tr><td colspan="'+(3+_avalPerguntas.length)+'" style="text-align:center;color:#94a3b8;padding:12px">Nenhuma resposta encontrada.</td></tr>'; }
  pagina.forEach(function(r){
    html += '<tr><td>'+escHtml(toTitleCase(r.nome||''))+'</td><td>'+escHtml(r.email||'')+'</td>';
    r.notas.forEach(function(n){ html += '<td style="text-align:center">'+n+'</td>'; });
    html += '<td>'+escHtml(r.sugestao||'')+'</td></tr>';
  });
  html += '</tbody></table>';
  html += paginacaoBotoesHtml(paginaAtual, filtradas.length, AVAL_POR_PAGINA, 'irParaPaginaAval('+di+',');
  wrap.innerHTML = html;
}
function showTab(id, btn) {
