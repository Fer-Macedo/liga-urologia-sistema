<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="shortcut icon" href="/favicon.ico">
  <title>Meus Grupos — Portal Cientifico</title>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Archivo:wght@700;800&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'IBM Plex Sans',system-ui,sans-serif;background:#F0F4F2;min-height:100vh;padding-top:84px;padding-bottom:96px}
    .topbar{background:#0C231B;padding:0 28px;height:84px;display:flex;align-items:center;justify-content:space-between;position:fixed;top:0;left:0;right:0;z-index:50}
    .topbar-brand{display:flex;align-items:center;gap:10px}
    .topbar-logo{width:32px;height:32px;background:#fff;border-radius:50%;overflow:hidden;display:flex;align-items:center;justify-content:center}
    .topbar-logo img{width:100%;height:100%;object-fit:cover;border-radius:50%}
    .topbar-nome{font-family:'Archivo',sans-serif;font-weight:800;font-size:14px;color:#fff}
    .topbar-sub{font-size:10px;color:#5E7A6D;text-transform:uppercase;letter-spacing:2px;margin-top:1px}
    .topbar-user{display:flex;align-items:center;gap:10px;position:relative}
    .topbar-user span{font-size:12.5px;color:#CFE0D7;cursor:pointer;padding:6px 4px}
    .topbar-logout{font-size:12px;color:#8FA89C;text-decoration:none;padding:5px 10px;border:1px solid rgba(255,255,255,.15)}
    .topbar-logout:hover{color:#fff;border-color:rgba(255,255,255,.4)}
    .topbar-menu{position:relative}
    .topbar-menu-drop{position:absolute;top:100%;right:0;background:#fff;border:1px solid #DDE3DF;box-shadow:0 8px 24px rgba(0,0,0,.12);min-width:180px;padding:6px;display:none;z-index:60}
    .topbar-menu:hover .topbar-menu-drop{display:block}
    .topbar-menu-drop a{display:block;padding:9px 12px;font-size:12.5px;color:#0C231B;text-decoration:none;border-radius:2px}
    .topbar-menu-drop a:hover{background:#F0F4F2;color:#0F6E56}
    .main{max-width:900px;margin:0 auto;padding:32px 20px;width:100%;flex:1}

    .hero{background:linear-gradient(135deg,#0d2a1b,#0C231B 60%,#071610);position:relative;overflow:hidden;padding:28px 30px;margin-bottom:28px}
    .hero::before{content:'';position:absolute;width:280px;height:280px;top:-100px;right:-80px;background:radial-gradient(circle,rgba(15,110,86,.35),transparent 65%);pointer-events:none}
    .hero-tag{display:inline-flex;align-items:center;gap:6px;font-family:'IBM Plex Mono';font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#4ade80;border:1px solid rgba(74,222,128,.35);padding:4px 10px;margin-bottom:14px;position:relative}
    .hero h1{position:relative;font-size:24px;font-weight:700;color:#fff;margin-bottom:4px}
    .hero h1 span{color:#4ade80}
    .hero p{position:relative;font-size:13px;color:rgba(255,255,255,.55)}

    .pg-title{font-size:18px;font-weight:700;color:#0C231B;margin-bottom:6px}
    .pg-sub{font-size:13px;color:#6B7A72;margin-bottom:20px}
    .grupos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
    .grupo-card{background:#fff;border:1px solid #DDE3DF;padding:22px;text-decoration:none;display:block;transition:.15s}
    .grupo-card:hover{border-color:#0F6E56;box-shadow:0 2px 12px rgba(15,110,86,.1)}
    .grupo-proj{font-size:11px;font-weight:600;color:#5E7A6D;text-transform:uppercase;letter-spacing:.8px;margin-bottom:8px}
    .grupo-nome{font-size:15px;font-weight:700;color:#0C231B;margin-bottom:10px;line-height:1.3}
    .grupo-meta{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px}
    .grupo-meta span{font-size:12px;color:#6B7A72;display:flex;align-items:center;gap:5px}
    .vstatus{display:inline-flex;padding:3px 9px;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;border:1px solid}
    .vstatus-aguardando{background:#f8fafc;color:#64748b;border-color:#cbd5e1}
    .vstatus-em_revisao{background:#fff7ed;color:#c2410c;border-color:#fed7aa}
    .vstatus-devolvido{background:#fef2f2;color:#b91c1c;border-color:#fecaca}
    .vstatus-aprovado{background:#f0fdf4;color:#15803d;border-color:#bbf7d0}
    .grupo-cta{font-size:12.5px;font-weight:600;color:#0F6E56;display:flex;align-items:center;gap:5px}

    .empty{background:#fff;border:1px solid #DDE3DF;text-align:center;padding:48px 28px}
    .empty-ic{width:56px;height:56px;background:#E8F5F0;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
    .empty h3{font-size:16px;font-weight:700;color:#0C231B;margin-bottom:8px}
    .empty p{font-size:13px;color:#6B7A72;max-width:380px;margin:0 auto}
    .empty-card{display:inline-flex;align-items:center;gap:10px;margin-top:22px;padding:10px 16px;background:#F0F4F2;border:1px solid #DDE3DF;font-size:12.5px;color:#0C231B}
    .empty-card b{font-weight:700}
    .empty-badge{font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;background:#0F6E56;color:#fff;padding:2px 8px;border-radius:2px}

    .alert-ok{padding:10px 14px;background:#f0fdf4;border:1px solid #bbf7d0;color:#15803d;font-size:13px;margin-bottom:20px}
    @media(max-width:600px){.grupos-grid{grid-template-columns:1fr}}

    .sec{margin-top:36px}
    .mat-card{background:#fff;border:1px solid #DDE3DF;display:flex;align-items:center;gap:14px;padding:16px 18px;text-decoration:none;transition:.15s}
    .mat-card:hover{border-color:#0F6E56;box-shadow:0 2px 12px rgba(15,110,86,.1)}
    .mat-ic{width:38px;height:38px;background:#E8F5F0;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .mat-titulo{font-size:13.5px;font-weight:700;color:#0C231B}
    .mat-desc{font-size:12px;color:#6B7A72;margin-top:2px}
    .tools-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}
    .tool-item{background:#fff;border:1px solid #DDE3DF;padding:14px 16px;text-decoration:none;display:block}
    .tool-item:hover{border-color:#0F6E56}
    .tool-nome{font-size:13px;font-weight:700;color:#0C231B}
    .tool-uso{font-size:11.5px;color:#6B7A72;margin-top:2px}
    .check-card{background:#fff;border:1px solid #DDE3DF;padding:20px 22px}
    .check-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-top:14px}
    .check-col-titulo{font-size:11.5px;font-weight:700;color:#b91c1c;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
    .check-col ul{list-style:none;display:flex;flex-direction:column;gap:6px}
    .check-col li{font-size:12.5px;color:#374151;padding-left:16px;position:relative}
    .check-col li::before{content:'';position:absolute;left:0;top:6px;width:6px;height:6px;background:#dc2626;border-radius:50%}

    footer{background:#0C231B;padding:0 28px;height:76px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;position:fixed;bottom:0;left:0;right:0;z-index:50}
    .pf-logo-f{width:22px;height:22px;border-radius:50%;object-fit:cover}
    .pf-n{font-size:12px;font-weight:700;color:#fff}
    .pf-sep{color:rgba(255,255,255,.3);margin:0 4px}
    .pf-inf{font-size:11px;color:rgba(255,255,255,.4)}
    .pf-copy{font-size:11px;color:rgba(255,255,255,.25)}
    .pf-socials{display:flex;gap:6px}
    .pf-soc{width:28px;height:28px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.5);transition:all .15s;text-decoration:none}
    .pf-soc:hover{background:#0F6E56;color:#fff}
    .pf-soc svg{width:13px;height:13px}
    @media(max-width:600px){footer{flex-direction:column;align-items:flex-start;height:auto;padding:12px 20px;position:static}body{padding-bottom:0}}
  </style>
</head>
<body>
<div class="topbar">
  <div class="topbar-brand">
    <div class="topbar-logo"><%if(config.org_logo){%><img src="<%=config.org_logo%>" alt=""><%}else{%><span style="font-family:'Archivo';font-weight:800;color:#0F6E56;font-size:13px">LU</span><%}%></div>
    <div><div class="topbar-nome"><%=config.org_nome||'LAURO'%></div><div class="topbar-sub">Portal Cientifico</div></div>
  </div>
  <div class="topbar-user">
    <div class="topbar-menu">
      <span><%=membro.nome%></span>
      <div class="topbar-menu-drop">
        <a href="/portal/meus-dados">Meus Dados</a>
        <a href="/portal/trocar-senha">Alterar senha</a>
      </div>
    </div>
    <a href="/portal/logout" class="topbar-logout">Sair</a>
  </div>
</div>
<div class="main">
  <%if(msg&&msg.length){%><div class="alert-ok"><%=msg[0]%></div><%}%>

  <div class="hero">
    <div class="hero-tag"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>Portal Cientifico</div>
    <h1><%=saudacao%>, <span><%=membro.nome.split(' ')[0]%></span>!</h1>
    <p><%=dataHoje%> &middot; <%=tipoLabel%> da LAURO</p>
  </div>

  <%if(podeEditarCadastro){%>
  <a href="/portal/meus-dados" style="display:flex;align-items:center;gap:12px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;padding:14px 18px;margin-bottom:24px;text-decoration:none;font-size:13px">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2410c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
    <div><b>A atualização do seu cadastro está liberada.</b> Clique aqui para revisar e corrigir seus dados.</div>
  </a>
  <%}%>

  <div class="pg-title">Meus Grupos</div>
  <div class="pg-sub">Projetos cientificos nos quais voce esta participando</div>
  <%if(grupos.length===0){%>
  <div class="empty">
    <div class="empty-ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
    <h3>Voce ainda nao esta em nenhum grupo</h3>
    <p>Assim que a coordenacao do Cientifico te adicionar a um grupo de trabalho, ele vai aparecer bem aqui, com prazo e status da submissao.</p>
    <div class="empty-card">
      <span class="empty-badge">Logado</span>
      <span>como <b><%=membro.nome%></b></span>
    </div>
  </div>
  <%}else{%>
  <div class="grupos-grid">
    <%grupos.forEach(function(g){%>
    <a href="/portal/grupo/<%=g.grupo_id%>" class="grupo-card">
      <div class="grupo-proj"><%=g.projeto_titulo%></div>
      <div class="grupo-nome"><%=g.grupo_nome%></div>
      <div class="grupo-meta">
        <%if(g.prazo){%><span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><%=new Date(g.prazo).toLocaleDateString('pt-BR')%></span><%}%>
        <%if(g.ultimo_status){%><span class="vstatus vstatus-<%=g.ultimo_status%>"><%=g.ultimo_status.replace('_',' ')%></span><%}%>
      </div>
      <div class="grupo-cta">Acessar grupo <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></div>
    </a>
    <%})%>
  </div>
  <%}%>

  <%if(gruposEncerrados && gruposEncerrados.length){%>
  <div class="sec">
    <div class="pg-title">Grupos encerrados</div>
    <div class="pg-sub">Trabalhos ja finalizados — continuam disponiveis so para consulta e download.</div>
    <div class="grupos-grid">
      <%gruposEncerrados.forEach(function(g){%>
      <a href="/portal/grupo/<%=g.grupo_id%>" class="grupo-card" style="opacity:.75">
        <div class="grupo-proj"><%=g.projeto_titulo%></div>
        <div class="grupo-nome"><%=g.grupo_nome%></div>
        <div class="grupo-meta">
          <span style="background:#f3f4f6;color:#6b7280;font-weight:700;padding:2px 8px;font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;border:1px solid #e5e7eb">Encerrado</span>
        </div>
        <div class="grupo-cta">Consultar <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></div>
      </a>
      <%})%>
    </div>
  </div>
  <%}%>

  <%if(materiais && materiais.length){%>
  <div class="sec">
    <div class="pg-title">Materiais de Apoio</div>
    <div class="pg-sub">Conteudo para te ajudar a produzir seu trabalho cientifico</div>
    <%materiais.forEach(function(m){%>
    <a href="/portal/materiais/<%=m.id%>/arquivo" target="_blank" class="mat-card">
      <div class="mat-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
      <div style="flex:1">
        <div class="mat-titulo"><%=m.titulo%></div>
        <%if(m.descricao){%><div class="mat-desc"><%=m.descricao%></div><%}%>
      </div>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
    </a>
    <%})%>
  </div>
  <%}%>

  <div class="sec">
    <div class="pg-title">Ferramentas Recomendadas</div>
    <div class="pg-sub">Bases de busca e IA para pesquisa e escrita cientifica</div>
    <div class="tools-grid">
      <a href="https://pubmed.ncbi.nlm.nih.gov" target="_blank" class="tool-item"><div class="tool-nome">PubMed / MEDLINE</div><div class="tool-uso">Busca de artigos e literatura</div></a>
      <a href="https://www.scopus.com" target="_blank" class="tool-item"><div class="tool-nome">Scopus</div><div class="tool-uso">Base multidisciplinar</div></a>
      <a href="https://scispace.com" target="_blank" class="tool-item"><div class="tool-nome">SciSpace</div><div class="tool-uso">IA para leitura de artigos</div></a>
      <a href="https://elicit.com" target="_blank" class="tool-item"><div class="tool-nome">Elicit</div><div class="tool-uso">IA para revisao de literatura</div></a>
      <a href="https://www.researchrabbitapp.com" target="_blank" class="tool-item"><div class="tool-nome">ResearchRabbit</div><div class="tool-uso">Mapa de referencias relacionadas</div></a>
      <a href="https://www.zotero.org" target="_blank" class="tool-item"><div class="tool-nome">Zotero</div><div class="tool-uso">Gestao de referencias</div></a>
      <a href="https://www.grammarly.com" target="_blank" class="tool-item"><div class="tool-nome">Grammarly</div><div class="tool-uso">Revisao de texto em ingles</div></a>
      <a href="https://www.writefull.com" target="_blank" class="tool-item"><div class="tool-nome">Writefull</div><div class="tool-uso">IA para escrita academica</div></a>
    </div>
  </div>

  <div class="sec">
    <div class="pg-title">Erros que Reprovam Manuscritos</div>
    <div class="pg-sub">Confira antes de submeter seu trabalho</div>
    <div class="check-card">
      <div class="check-grid">
        <div class="check-col">
          <div class="check-col-titulo">Metodologia</div>
          <ul>
            <li>Calculo amostral ausente</li>
            <li>Sem aprovacao do CEP</li>
            <li>Criterios de elegibilidade vagos</li>
          </ul>
        </div>
        <div class="check-col">
          <div class="check-col-titulo">Escrita</div>
          <ul>
            <li>Discussao repete os resultados</li>
            <li>Introducao sem lacuna clara</li>
            <li>Valor-p sem IC95%</li>
          </ul>
        </div>
        <div class="check-col">
          <div class="check-col-titulo">Submissao</div>
          <ul>
            <li>Periodico inadequado ao escopo</li>
            <li>Cover letter generica</li>
            <li>Formatacao fora das normas</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
<footer>
  <div style="display:flex;align-items:center;gap:8px">
    <img src="/img/logo-lauro.png" alt="LAURO" class="pf-logo-f" style="border-radius:50%;object-fit:contain" onerror="this.style.display='none'">
    <span class="pf-n">LAURO</span>
    <span class="pf-sep">&middot;</span>
    <span class="pf-inf">Liga Academica de Urologia &middot; Portal Cientifico</span>
  </div>
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <div class="pf-socials">
      <a href="https://wa.me/595994868368" target="_blank" class="pf-soc" title="WhatsApp LAURO">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>
      </a>
      <a href="https://www.instagram.com/lauroucp.cde/" target="_blank" class="pf-soc" title="Instagram LAURO">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
      <a href="https://www.youtube.com/@LAUROUCPCDE" target="_blank" class="pf-soc" title="YouTube LAURO">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
    </div>
    <span class="pf-copy">&copy; <%=new Date().getFullYear()%></span>
    <a href="https://central.edu.py/" target="_blank" rel="noopener" style="display:flex;align-items:center;opacity:.35;transition:opacity .2s" onmouseover="this.style.opacity='.7'" onmouseout="this.style.opacity='.35'">
      <img src="/img/logo-ucp.png" alt="UCP" style="height:20px;filter:brightness(0) invert(1);object-fit:contain">
    </a>
  </div>
</footer>
</body></html>
