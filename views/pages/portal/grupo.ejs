function polirTexto() {
  var texto = document.getElementById('polir-texto').value.trim();
  if(!texto){ alert('Pegue el texto primero.'); return; }
  var btn = document.getElementById('btn-polir');
  var out = document.getElementById('polir-resultado');
  btn.disabled = true; var orig = btn.innerHTML; btn.innerHTML = 'Analizando...';
  out.innerHTML = '';
  fetch('/portal/grupo/'+GRUPO_ID+'/polir-texto', {
    method: 'POST', credentials: 'same-origin',
    headers: {'Content-Type':'application/x-www-form-urlencoded'},
    body: 'texto=' + encodeURIComponent(texto)
  })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.disabled = false; btn.innerHTML = orig;
      if(!data.ok){ out.innerHTML = '<span style="color:#b91c1c">'+(data.erro||'Error al pulir el texto.')+'</span>'; return; }
      var r = data.resultado;
      var html = '<div style="background:#F0F4F2;padding:10px 12px;border:1px solid #DDE3DF;margin-bottom:8px">'+r.texto_polido+'</div>';
      if(r.sugestoes_titulo && r.sugestoes_titulo.length){
        html += '<div><b>Sugerencias de título:</b><ul style="margin:4px 0 0 18px">' + r.sugestoes_titulo.map(function(t){return '<li>'+t+'</li>';}).join('') + '</ul></div>';
      }
      html += '<p style="margin-top:8px;color:#6B7A72">Copie el texto de arriba y péguelo en el Editor de Documento, más abajo.</p>';
      out.innerHTML = html;
    })
    .catch(function(){ btn.disabled=false; btn.innerHTML=orig; out.innerHTML='<span style="color:#b91c1c">Error de conexión.</span>'; });
}

function _editorCampos() {
  return {
    texto: document.getElementById('editor-documento').value.trim(),
    titulo: document.getElementById('editor-titulo').value.trim(),
    norma: document.getElementById('editor-norma').value
  };
}

function salvarRascunho() {
  var c = _editorCampos();
  var btn = document.getElementById('btn-rascunho-salvar');
  var out = document.getElementById('editor-resultado');
  var orig = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Guardando...';
  fetch('/portal/grupo/'+GRUPO_ID+'/rascunho/salvar', {
    method: 'POST', credentials: 'same-origin',
    headers: {'Content-Type':'application/x-www-form-urlencoded'},
    body: 'texto=' + encodeURIComponent(c.texto) + '&titulo=' + encodeURIComponent(c.titulo) + '&norma=' + encodeURIComponent(c.norma)
  })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.disabled = false; btn.innerHTML = orig;
      out.innerHTML = data.ok ? '<span style="color:#0F6E56">¡Borrador guardado! Puede continuar desde donde quedó en cualquier momento.</span>' : '<span style="color:#b91c1c">'+(data.erro||'Error al guardar.')+'</span>';
    })
    .catch(function(){ btn.disabled=false; btn.innerHTML=orig; out.innerHTML='<span style="color:#b91c1c">Error de conexión.</span>'; });
}

function baixarRascunho() {
  var c = _editorCampos();
  var btn = document.getElementById('btn-rascunho-baixar');
  var out = document.getElementById('editor-resultado');
  if(!c.texto){ out.innerHTML = '<span style="color:#b91c1c">Escriba o pegue el trabajo primero.</span>'; return; }
  var orig = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Generando...';
  fetch('/portal/grupo/'+GRUPO_ID+'/rascunho/baixar', {
    method: 'POST', credentials: 'same-origin',
    headers: {'Content-Type':'application/x-www-form-urlencoded'},
    body: 'texto=' + encodeURIComponent(c.texto) + '&titulo=' + encodeURIComponent(c.titulo) + '&norma=' + encodeURIComponent(c.norma)
  })
    .then(function(r){
      if(!r.ok) return r.text().then(function(t){ throw new Error(t || 'Error al generar el documento.'); });
      return r.blob();
    })
    .then(function(blob){
      btn.disabled = false; btn.innerHTML = orig;
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = (c.titulo || 'Trabajo Científico').replace(/[^a-zA-Z0-9 ]+/g,'').trim() + '.docx';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(url);
      out.innerHTML = '<span style="color:#0F6E56">Documento descargado.</span>';
    })
    .catch(function(e){ btn.disabled=false; btn.innerHTML=orig; out.innerHTML='<span style="color:#b91c1c">'+(e.message||'Error de conexión.')+'</span>'; });
}

function editarNoGoogle() {
  var c = _editorCampos();
  var btn = document.getElementById('btn-rascunho-google');
  var out = document.getElementById('editor-resultado');
  if(!c.texto){ out.innerHTML = '<span style="color:#b91c1c">Escriba o pegue el trabajo primero.</span>'; return; }
  var orig = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Abriendo en Google Docs...';
  fetch('/portal/grupo/'+GRUPO_ID+'/rascunho/editar-google', {
    method: 'POST', credentials: 'same-origin',
    headers: {'Content-Type':'application/x-www-form-urlencoded'},
    body: 'texto=' + encodeURIComponent(c.texto) + '&titulo=' + encodeURIComponent(c.titulo) + '&norma=' + encodeURIComponent(c.norma)
  })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.disabled = false; btn.innerHTML = orig;
      if(!data.ok){ out.innerHTML = '<span style="color:#b91c1c">'+(data.erro||'Error al abrir en Google Docs.')+'</span>'; return; }
      document.getElementById('google-doc-area').style.display = '';
      document.getElementById('google-doc-iframe').src = data.embedUrl;
      document.getElementById('link-google-abrir').href = data.docUrl;
      document.getElementById('link-google-baixar').href = 'https://docs.google.com/document/d/'+data.fileId+'/export?format=docx';
      document.getElementById('link-google-imprimir').href = 'https://docs.google.com/document/d/'+data.fileId+'/export?format=pdf';
      out.innerHTML = '<span style="color:#0F6E56">Documento abierto en Google Docs abajo. Edite directo ahí — se guarda automáticamente por Google. Solo quien tenga acceso a esta página del grupo puede editar; después de enviar para evaluación, el documento se bloquea automáticamente (queda de solo lectura).</span>';
    })
    .catch(function(){ btn.disabled=false; btn.innerHTML=orig; out.innerHTML='<span style="color:#b91c1c">Error de conexión.</span>'; });
}

function revisarRascunhoComIA() {
  var btn = document.getElementById('btn-rascunho-ia');
  var box = document.getElementById('ia-revisao-rascunho');
  btn.disabled = true;
  var orig = btn.innerHTML;
  btn.innerHTML = 'Analizando... (puede tardar hasta 30s)';
  box.style.display = 'none';
  fetch('/portal/grupo/'+GRUPO_ID+'/rascunho/revisar-ia', { method: 'POST', credentials: 'same-origin' })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.disabled = false; btn.innerHTML = orig;
      if(!data.ok){ box.style.display='block'; box.innerHTML = '<span style="color:#b91c1c">'+(data.erro||'Error al revisar.')+'</span>'; return; }
      renderRevisaoIA('rascunho', data.revisao);
    })
    .catch(function(){ btn.disabled=false; btn.innerHTML=orig; box.style.display='block'; box.innerHTML='<span style="color:#b91c1c">Error de conexión.</span>'; });
}

function enviarRascunhoParaAvaliacao() {
  var btn = document.getElementById('btn-rascunho-enviar');
  var statusEl = document.getElementById('rascunho-envio-status');
  var orig = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Enviando...';
  statusEl.innerHTML = '';
  fetch('/portal/grupo/'+GRUPO_ID+'/rascunho/enviar', { method: 'POST', credentials: 'same-origin' })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.disabled = false; btn.innerHTML = orig;
      if(!data.ok){ statusEl.innerHTML = '<span style="color:#b91c1c">'+(data.erro||'Error al enviar.')+'</span>'; return; }
      statusEl.innerHTML = '<span style="color:#0F6E56">¡Enviado para evaluación! El documento fue bloqueado (solo lectura) para que nadie lo edite por accidente hasta la corrección. Actualizando página...</span>';
      setTimeout(function(){ location.reload(); }, 1200);
    })
    .catch(function(){ btn.disabled=false; btn.innerHTML=orig; statusEl.innerHTML='<span style="color:#b91c1c">Error de conexión.</span>'; });
}
