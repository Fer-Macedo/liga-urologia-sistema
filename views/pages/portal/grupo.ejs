<div class="prazo-ov" id="prazo-modal">
  <div class="prazo-card" id="prazo-card">
    <div class="prazo-card-body">
      <div class="prazo-icone"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
      <div class="prazo-titulo" id="prazo-titulo"></div>
      <div class="prazo-texto" id="prazo-texto"></div>
      <div class="prazo-btns">
        <button class="btn" onclick="fecharPrazoModal()">Ya lo vi, gracias</button>
      </div>
    </div>
  </div>
</div>

<script>
<% if (typeof diasRestantesPrazo !== 'undefined' && diasRestantesPrazo !== null) { %>
(function(){
  var dias = <%=diasRestantesPrazo%>;
  var chave = 'prazoAvisado_<%=grupo.id%>_'+dias;
  if (sessionStorage.getItem(chave)) return;
  var titulo = document.getElementById('prazo-titulo');
  var texto = document.getElementById('prazo-texto');
  var card = document.getElementById('prazo-card');
  if (dias === 0) {
    titulo.textContent = '¡Hoy es el último día del plazo!';
    texto.textContent = 'El plazo para enviar este trabajo termina hoy. Envíelo lo antes posible desde la pestaña Trabajo.';
    card.classList.add('urgente');
  } else {
    titulo.textContent = '¡Faltan '+dias+(dias===1?' día':' días')+' para el plazo!';
    texto.textContent = 'El plazo para enviar este trabajo se acerca. No lo deje para último momento.';
    if (dias<=1) card.classList.add('urgente');
  }
  document.getElementById('prazo-modal').classList.add('open');
  sessionStorage.setItem(chave, '1');
})();
<% } %>
function fecharPrazoModal(){ document.getElementById('prazo-modal').classList.remove('open'); }
function tab(btn,id){
  document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('ativo')});
  document.querySelectorAll('.tab-content').forEach(function(t){t.classList.remove('ativo')});
  btn.classList.add('ativo');
  document.getElementById('tab-'+id).classList.add('ativo');
  if(id==='chat'){var m=document.getElementById('chat-msgs');if(m)m.scrollTop=m.scrollHeight;}
}
document.addEventListener('DOMContentLoaded',function(){
  var m=document.getElementById('chat-msgs');
  if(m)m.scrollTop=m.scrollHeight;
  var t=new URLSearchParams(window.location.search).get('tab');
  if(t){var b=document.querySelector('.tab[onclick*="\''+t+'\'"]');if(b)tab(b,t);}
});

var GRUPO_ID = <%=grupo.id%>;
var PROJETO_ID = <%=projeto.id%>;
var statusLbl = {ok:{txt:'OK',cor:'#15803d',bg:'#f0fdf4'},atencao:{txt:'Atención',cor:'#c2410c',bg:'#fff7ed'},ausente:{txt:'Ausente',cor:'#b91c1c',bg:'#fef2f2'}};

function renderRevisaoIA(versaoId, revisao) {
  var box = document.getElementById('ia-revisao-'+versaoId);
  if(!box) return;
  var html = '';
  if(revisao.resumo) html += '<div style="margin-bottom:10px"><b>Resumen:</b> '+revisao.resumo+'</div>';
  if(revisao.estrutura_imrad){
    html += '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">';
    ['introducao','metodos','resultados','discussao'].forEach(function(k){
      var v = revisao.estrutura_imrad[k]; if(!v) return;
      var s = statusLbl[v] || statusLbl.atencao;
      html += '<span style="background:'+s.bg+';color:'+s.cor+';font-weight:700;padding:2px 8px;font-size:10.5px;text-transform:capitalize">'+k+': '+s.txt+'</span>';
    });
    html += '</div>';
  }
  if(revisao.pontos_fortes && revisao.pontos_fortes.length){
    html += '<div style="margin-bottom:8px"><b style="color:#15803d">Puntos fuertes:</b><ul style="margin:4px 0 0 18px">';
    revisao.pontos_fortes.forEach(function(p){ html += '<li>'+p+'</li>'; });
    html += '</ul></div>';
  }
  if(revisao.pontos_atencao && revisao.pontos_atencao.length){
    html += '<div style="margin-bottom:8px"><b style="color:#c2410c">Puntos de atención:</b><ul style="margin:4px 0 0 18px">';
    revisao.pontos_atencao.forEach(function(p){ html += '<li>'+p+'</li>'; });
    html += '</ul></div>';
  }
  if(revisao.sugestao_periodicos && revisao.sugestao_periodicos.length){
    html += '<div><b>Revistas sugeridas:</b> '+revisao.sugestao_periodicos.join(', ')+'</div>';
  }
  box.innerHTML = html;
  box.style.display = 'block';
}

function revisarComIA(versaoId) {
  var btn = document.getElementById('btn-ia-'+versaoId);
  var box = document.getElementById('ia-revisao-'+versaoId);
  btn.disabled = true;
  var orig = btn.innerHTML;
  btn.innerHTML = 'Analizando... (puede tardar hasta 30s)';
  fetch('/portal/grupo/'+GRUPO_ID+'/versao/'+versaoId+'/revisar-ia', { method: 'POST', credentials: 'same-origin' })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.disabled = false; btn.innerHTML = orig;
      if(!data.ok){ box.style.display='block'; box.innerHTML = '<span style="color:#b91c1c">'+(data.erro||'Error al revisar.')+'</span>'; return; }
      renderRevisaoIA(versaoId, data.revisao);
    })
    .catch(function(){ btn.disabled=false; btn.innerHTML=orig; box.style.display='block'; box.innerHTML='<span style="color:#b91c1c">Error de conexión.</span>'; });
}

function gerarPico() {
  var ideia = document.getElementById('pico-ideia').value.trim();
  if(!ideia){ alert('Describa la idea del estudio primero.'); return; }
  var btn = document.getElementById('btn-pico');
  btn.disabled = true;
  var orig = btn.innerHTML;
  btn.innerHTML = 'Generando...';
  fetch('/portal/projeto/'+PROJETO_ID+'/pico', {
    method: 'POST', credentials: 'same-origin',
    headers: {'Content-Type':'application/x-www-form-urlencoded'},
    body: 'ideia=' + encodeURIComponent(ideia)
  })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.disabled = false; btn.innerHTML = 'Generar nuevamente';
      if(!data.ok){ alert(data.erro || 'Error al generar PICO.'); return; }
      var p = data.pico;
      document.getElementById('pico-conteudo').innerHTML =
        '<div style="font-size:12.5px;color:#0C231B;margin-bottom:10px;line-height:1.5">'+p.pergunta_formatada+'</div>'
        + '<div style="font-size:11px;color:#6B7A72;display:flex;flex-direction:column;gap:3px">'
        + '<span><b>P:</b> '+p.populacao+'</span>'
        + '<span><b>I:</b> '+p.intervencao+'</span>'
        + '<span><b>C:</b> '+p.comparacao+'</span>'
        + '<span><b>O:</b> '+p.desfecho+'</span></div>';
    })
    .catch(function(){ btn.disabled=false; btn.innerHTML=orig; alert('Error de conexión.'); });
}

function listaArtigosHtml(artigos) {
  if(!artigos || !artigos.length) return '<p style="color:#6B7A72">Ningún artículo encontrado.</p>';
  return '<div style="display:flex;flex-direction:column;gap:8px">' + artigos.map(function(a){
    return '<a href="'+a.link+'" target="_blank" style="display:block;text-decoration:none;color:inherit;border:1px solid #DDE3DF;padding:10px 12px">'
      + '<div style="font-weight:700;color:#0C231B;font-size:12.5px">'+a.titulo+'</div>'
      + '<div style="color:#6B7A72;font-size:11px;margin-top:2px">'+(a.autores||'')+' &middot; '+(a.revista||'')+' &middot; '+(a.ano||'')+'</div>'
      + '</a>';
  }).join('') + '</div>';
}

function buscarLiteratura() {
  var termo = document.getElementById('pesq-termo').value.trim();
  if(!termo){ alert('Describa el tema de la búsqueda.'); return; }
  var btn = document.getElementById('btn-pesq');
  var out = document.getElementById('pesq-resultado');
  btn.disabled = true; var orig = btn.innerHTML; btn.innerHTML = 'Buscando...';
  out.innerHTML = '';
  fetch('/portal/grupo/'+GRUPO_ID+'/buscar-literatura', {
    method: 'POST', credentials: 'same-origin',
    headers: {'Content-Type':'application/x-www-form-urlencoded'},
    body: 'termo=' + encodeURIComponent(termo)
  })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.disabled = false; btn.innerHTML = orig;
      if(!data.ok){ out.innerHTML = '<span style="color:#b91c1c">'+(data.erro||'Error en la búsqueda.')+'</span>'; return; }
      var html = '';
      if(data.sintese) html += '<div style="background:#F0F4F2;padding:10px 12px;margin-bottom:10px;border:1px solid #DDE3DF"><b>Síntesis:</b> '+data.sintese+'</div>';
      html += listaArtigosHtml(data.artigos);
      out.innerHTML = html;
    })
    .catch(function(){ btn.disabled=false; btn.innerHTML=orig; out.innerHTML='<span style="color:#b91c1c">Error de conexión.</span>'; });
}

function buscarRelacionados() {
  var termo = document.getElementById('relac-termo').value.trim();
  if(!termo){ alert('Pegue un título o tema.'); return; }
  var btn = document.getElementById('btn-relac');
  var out = document.getElementById('relac-resultado');
  btn.disabled = true; var orig = btn.innerHTML; btn.innerHTML = 'Buscando...';
