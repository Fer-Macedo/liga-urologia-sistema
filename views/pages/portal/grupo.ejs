    <%avisos.forEach(function(a){%>
    <div class="aviso-item">
      <div class="aviso-meta"><%=new Date(a.criado_em).toLocaleDateString('es-PY',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'})%></div>
