<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<link rel="shortcut icon" href="/favicon.ico">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%=pessoa.nome%> — LAURO</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--v:#0C231B;--vm:#0F6E56;--vl:#E8F5F0;--bg:#F4F6F5;--card:#fff;--brd:#E5EBE8;--t:#0C231B;--ts:#6B7A72;--ff:'Plus Jakarta Sans',system-ui,sans-serif}
html,body{height:100%;font-family:var(--ff)}
body{min-height:100vh;background:linear-gradient(160deg,#0d2a1b,#0C231B 45%,#071610);display:flex;align-items:center;justify-content:center;padding:32px 16px}
.card{background:var(--card);max-width:420px;width:100%;padding:40px 36px;text-align:center;box-shadow:0 24px 64px rgba(0,0,0,.3)}
.foto{width:220px;max-width:100%;height:auto;max-height:320px;border-radius:16px;object-fit:contain;margin:0 auto 20px;border:4px solid var(--vl);display:block;background:var(--vl)}
.foto-fb{width:140px;height:140px;border-radius:50%;margin:0 auto 20px;background:var(--vm);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:44px}
.nome{font-size:22px;font-weight:800;color:var(--t);margin-bottom:6px}
.cargo{font-size:13px;font-weight:700;color:var(--vm);text-transform:uppercase;letter-spacing:.08em;margin-bottom:20px}
.badge{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;color:var(--ts);background:var(--bg);border:1px solid var(--brd);padding:6px 14px;margin-bottom:24px}
.voltar{display:inline-block;font-size:13px;font-weight:700;color:var(--vm);text-decoration:none;padding:11px 24px;border:1.5px solid var(--vm)}
.voltar:hover{background:var(--vm);color:#fff}
.rodape{margin-top:28px;font-size:11px;color:var(--ti,#A0ADA8)}
</style>
</head>
<body>
<div class="card">
  <%if(pessoa.foto_url){%>
  <img class="foto" id="fotoPerfil" src="<%=pessoa.foto_url%>" alt="<%=pessoa.nome%>" onerror="this.onerror=null;this.style.display='none';document.getElementById('fotoFallback').style.display='flex'">
  <div class="foto-fb" id="fotoFallback" style="display:none"><%=pessoa.nome.substring(0,1).toUpperCase()%></div>
  <%}else{%>
  <div class="foto-fb"><%=pessoa.nome.substring(0,1).toUpperCase()%></div>
  <%}%>
  <div class="nome"><%=pessoa.nome%></div>
  <div class="cargo"><%=pessoa.cargo%></div>
  <div class="badge"><%=tipo==='diretivo'?'Directivo':'Ligante'%> — LAURO</div>
  <div><a href="https://lauroucpcde.com/#equipo" class="voltar">← Ver todo el equipo</a></div>
  <div class="rodape">Liga Académica de Urología — UCP, Ciudad del Este</div>
</div>
</body>
</html>
