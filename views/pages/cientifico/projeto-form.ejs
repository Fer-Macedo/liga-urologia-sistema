<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="shortcut icon" href="/favicon.ico">
  <title><%=projeto?'Editar':'Novo'%> Projeto — <%= config.org_nome %></title>
  <link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/admin-modern.css">
  <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">
  <style>
    #quill-descricao{background:var(--fundo);min-height:140px}
    .ql-toolbar.ql-snow{border-color:var(--borda);background:var(--card)}
    .ql-container.ql-snow{border-color:var(--borda)}
    :root{--cor-primaria:<%=config.org_cor||'#1a56db'%>}
    .form-wrap{max-width:820px;margin:0 auto}
    .form-card{background:var(--card);border:1px solid var(--borda);margin-bottom:20px;overflow:hidden}
    .form-card-h{padding:16px 28px;border-bottom:1px solid var(--borda);background:var(--fundo)}
    .form-card-h h2{font-size:13px;font-weight:700;color:var(--cor-primaria);margin:0;text-transform:uppercase;letter-spacing:.06em}
    .form-card-b{padding:28px}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .form-group{margin-bottom:18px}
    .form-group:last-child{margin-bottom:0}
    .form-group label{display:block;font-size:12px;font-weight:700;color:var(--texto);text-transform:uppercase;letter-spacing:.05em;margin-bottom:7px}
    .form-group input,.form-group select,.form-group textarea{width:100%;padding:11px 13px;border:1.5px solid var(--borda);background:var(--card);color:var(--texto);font-size:14px;border-radius:0;font-family:inherit;box-sizing:border-box;transition:border-color .15s}
    .form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:var(--cor-primaria)}
    .form-group textarea{resize:vertical;min-height:80px}
    .file-area{border:1.5px dashed var(--borda);padding:24px;text-align:center;cursor:pointer;background:var(--fundo);transition:all .15s}
    .file-area:hover{border-color:var(--cor-primaria);background:var(--card)}
    .file-area svg{color:var(--texto2)}
    .file-area p{font-size:12.5px;color:var(--texto2);margin:8px 0 0;font-weight:500}
    .file-atual{font-size:12px;color:var(--texto);font-weight:600;margin-top:10px;padding:10px 14px;background:var(--fundo);border:1px solid var(--borda);display:flex;align-items:center;gap:8px}
    .btn{padding:11px 22px;font-size:13px;font-weight:700;border:1.5px solid var(--borda);background:var(--card);color:var(--texto);cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:7px;border-radius:0;transition:all .15s}
    .btn:hover{border-color:var(--texto2)}
    .btn.pri{background:var(--cor-primaria);color:#fff;border-color:var(--cor-primaria)}
    .btn.pri:hover{opacity:.88;border-color:var(--cor-primaria)}
    .alert-err{padding:12px 16px;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;font-size:13px;margin-bottom:20px}
  </style>
</head>
<body>
<div class="layout">
  <%- include('../../partials/sidebar',{paginaAtual:'cientifico',config,usuario,permissoesAtivas:permissoesAtivas||[]}) %>
  <main class="main">
    <div class="topbar">
      <h1 class="page-titulo"><%=projeto?'Editar Projeto':'Novo Projeto Cientifico'%></h1>
      <div class="topbar-acoes">
        <a href="/cientifico" class="btn btn-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>Voltar</a>
      </div>
    </div>
    <div class="content">
<%- include('../../partials/_notificacoes') %>
<%if(erro&&erro.length){%><div class="alert-err"><%=erro[0]%></div><%}%>
<div class="form-wrap">
<form method="POST" id="form-projeto" action="<%=projeto?'/cientifico/projeto/'+projeto.id+'/editar':'/cientifico/novo'%>" enctype="multipart/form-data">
  <div class="form-card">
    <div class="form-card-h"><h2>Informacoes do Projeto</h2></div>
    <div class="form-card-b">
    <div class="form-group">
      <label>Titulo do Projeto / Evento / Revista *</label>
      <input type="text" name="titulo" required value="<%=projeto?projeto.titulo:''%>" placeholder="Ex: Congresso Brasileiro de Urologia 2025">
    </div>
    <div class="form-group">
      <label>Descricao</label>
      <div id="quill-descricao"></div>
      <textarea name="descricao" id="txt-descricao" style="display:none"><%=projeto?projeto.descricao||'':''%></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Prazo de Submissao</label>
        <input type="date" name="prazo" value="<%=projeto&&projeto.prazo?new Date(projeto.prazo).toISOString().split('T')[0]:''%>">
      </div>
      <div class="form-group">
        <label>Status</label>
        <select name="status">
          <option value="aberto" <%=!projeto||projeto.status==='aberto'?'selected':''%>>Aberto</option>
          <option value="revisao" <%=projeto&&projeto.status==='revisao'?'selected':''%>>Em Revisao</option>
          <option value="encerrado" <%=projeto&&projeto.status==='encerrado'?'selected':''%>>Encerrado</option>
        </select>
      </div>
    </div>
    </div>
  </div>
  <div class="form-card">
    <div class="form-card-h"><h2>Documentos do Projeto</h2></div>
    <div class="form-card-b">
    <div class="form-row">
      <div class="form-group">
        <label>Edital (PDF)</label>
        <%if(projeto&&projeto.edital_nome){%>
        <div class="file-atual">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <%=projeto.edital_nome%>
        </div>
        <p style="font-size:11px;color:var(--texto2);margin:4px 0">Selecionar novo arquivo substitui o atual</p>
        <%}%>
        <div class="file-area" onclick="document.getElementById('edital').click()">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <p>Clique para selecionar o edital</p>
        </div>
        <input type="file" id="edital" name="edital" accept=".pdf,.doc,.docx" style="display:none" onchange="mostrarArquivo(this,'edital')">
        <div id="nome-edital" style="font-size:11px;color:var(--cor-primaria);margin-top:4px"></div>
      </div>
      <div class="form-group">
        <label>Modelo de Documento</label>
        <%if(projeto&&projeto.modelo_nome){%>
        <div class="file-atual">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <%=projeto.modelo_nome%>
        </div>
        <p style="font-size:11px;color:var(--texto2);margin:4px 0">Selecionar novo arquivo substitui o atual</p>
        <%}%>
        <div class="file-area" onclick="document.getElementById('modelo').click()">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <p>Clique para selecionar o modelo</p>
        </div>
        <input type="file" id="modelo" name="modelo" accept=".pdf,.doc,.docx" style="display:none" onchange="mostrarArquivo(this,'modelo')">
        <div id="nome-modelo" style="font-size:11px;color:var(--cor-primaria);margin-top:4px"></div>
      </div>
    </div>
    </div>
  </div>
  <div style="display:flex;gap:10px;justify-content:flex-end">
    <a href="/cientifico" class="btn">Cancelar</a>
    <button type="submit" class="btn pri"><%=projeto?'Salvar alteracoes':'Criar projeto'%></button>
  </div>
</form>
</div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
<script>
var quillDescricao = new Quill('#quill-descricao', {
  theme: 'snow',
  placeholder: 'Descricao opcional do projeto',
  modules: { toolbar: [[{'font':[]},{'size':['small',false,'large','huge']}],['bold','italic','underline','strike'],[{'color':[]},{'background':[]}],[{'align':[]}],[{'list':'ordered'},{'list':'bullet'}],['link','image'],['clean']] }
});
quillDescricao.root.innerHTML = document.getElementById('txt-descricao').value;
document.getElementById('form-projeto').addEventListener('submit', function() {
  document.getElementById('txt-descricao').value = quillDescricao.getText().trim() ? quillDescricao.root.innerHTML : '';
});

function mostrarArquivo(input,id){
  var d=document.getElementById('nome-'+id);
  d.textContent=input.files[0]?input.files[0].name:'';
}
</script>
</body></html>
