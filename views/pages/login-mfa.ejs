<%
var cfg = (typeof config !== 'undefined' && config) ? config : {};
var orgNome = cfg.org_nome || 'LAURO — Liga Acadêmica de Urologia';
var orgLogo = cfg.org_logo || '/img/logo-lauro.png';
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <link rel="shortcut icon" href="/favicon.ico"><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verificação em duas etapas — <%= orgNome %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --ink:#10201A; --ink-soft:#3A4A43; --ink-faint:#74837C;
      --line:#E2E6E1; --line-strong:#CDD4CE; --paper:#F2F4F0; --card:#FFFFFF;
      --green-900:#0C231B; --green-800:#103024; --green-700:#15402F; --green-600:#1C5A41;
      --green-500:#23704F; --accent:#2FA873; --accent-bright:#37C98B;
      --red:#C0392B; --red-bg:#FBE9E7;
    }
    body{
      font-family:'IBM Plex Sans',system-ui,sans-serif; color:var(--ink);
      background:var(--paper); min-height:100vh; display:flex; align-items:center; justify-content:center;
      -webkit-font-smoothing:antialiased; padding:24px;
    }
    svg{display:block}
    .ic{stroke:currentColor;stroke-width:1.7;fill:none;stroke-linecap:square;stroke-linejoin:miter}
    .form-box{width:100%;max-width:380px;animation:rise .45s cubic-bezier(.16,1,.3,1) both;background:var(--card);border:1px solid var(--line);padding:36px 32px}
    @keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

    .icone-topo{width:46px;height:46px;border-radius:50%;background:var(--paper);border:1px solid var(--line-strong);display:grid;place-items:center;margin-bottom:18px}
    .icone-topo .ic{width:22px;height:22px;stroke:var(--green-600)}
    .form-head h1{font-family:'Archivo';font-weight:800;font-size:22px;letter-spacing:-.4px;color:var(--ink)}
    .form-head p{margin-top:8px;color:var(--ink-faint);font-size:13.5px;line-height:1.5}

    .alerta{
      display:flex;align-items:center;gap:9px;padding:11px 13px;font-size:13px;font-weight:500;
      margin:18px 0;border:1px solid var(--line-strong);
    }
    .alerta .ic{width:16px;height:16px;flex:0 0 16px}
    .alerta-erro{background:var(--red-bg);color:var(--red);border-color:rgba(192,57,43,.3)}
    .alerta-erro .ic{stroke:var(--red)}

    .campo{margin:22px 0 18px}
    .label{display:block;font-family:'IBM Plex Mono';font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--ink-faint);margin-bottom:10px}
    .input-codigo{
      width:100%;border:1px solid var(--line-strong);background:#fff;outline:none;
      font-family:'IBM Plex Mono';font-size:28px;letter-spacing:10px;text-align:center;
      padding:14px 10px 14px 20px;color:var(--ink);transition:border-color .16s ease,box-shadow .16s ease;
    }
    .input-codigo:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(47,168,115,.12)}

    .btn-login{
      width:100%;margin-top:6px;padding:13px;border:1px solid var(--accent);
      background:var(--accent);color:var(--green-900);
      font-family:'IBM Plex Sans';font-size:14px;font-weight:700;letter-spacing:.2px;
      cursor:pointer;position:relative;overflow:hidden;
      display:flex;align-items:center;justify-content:center;gap:9px;
      transition:background .16s ease,box-shadow .16s ease,transform .12s ease;
    }
    .btn-login:hover{background:var(--accent-bright);box-shadow:0 8px 20px -8px rgba(47,168,115,.7)}
    .btn-login:active{transform:translateY(1px)}
    .btn-login.loading{pointer-events:none;opacity:.85}
    .btn-login.loading .btn-text{opacity:0}
    .btn-login .spinner{display:none;position:absolute;inset:0;align-items:center;justify-content:center}
    .btn-login.loading .spinner{display:flex}
    @keyframes spin{to{transform:rotate(360deg)}}
    .spinner-ring{width:18px;height:18px;border:2px solid rgba(12,35,27,.3);border-top-color:var(--green-900);border-radius:50%;animation:spin .7s linear infinite}

    .link-voltar{display:block;text-align:center;margin-top:18px;font-size:12.5px;color:var(--ink-faint);text-decoration:none}
    .link-voltar:hover{color:var(--ink)}
    .rodape{margin-top:26px;text-align:center;font-family:'IBM Plex Mono';font-size:10px;letter-spacing:1px;color:var(--ink-faint)}
  </style>
</head>
<body>
  <div class="form-box">
    <div class="icone-topo">
      <svg viewBox="0 0 24 24" class="ic"><rect x="5" y="11" width="14" height="10" rx="1"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
    </div>
    <div class="form-head">
      <h1>Verificação em duas etapas</h1>
      <p>Digite o código de 6 dígitos do seu aplicativo autenticador.</p>
    </div>

    <% if (typeof erro !== 'undefined' && erro && erro.length > 0) { %>
      <div class="alerta alerta-erro">
        <svg viewBox="0 0 24 24" class="ic"><path d="M12 3L2 20h20z"/><path d="M12 10v5M12 17.5v.5"/></svg>
        <span><%= erro[0] %></span>
      </div>
    <% } %>

    <form action="/login/verificar" method="POST" id="form-mfa">
      <div class="campo">
        <label class="label">Código</label>
        <input type="text" name="codigo" class="input-codigo" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="000000" required autofocus autocomplete="one-time-code">
      </div>
      <button type="submit" class="btn-login" id="btn-verificar">
        <span class="btn-text">Verificar</span>
        <span class="spinner"><span class="spinner-ring"></span></span>
      </button>
    </form>

    <a href="/logout" class="link-voltar">Cancelar e voltar ao login</a>
    <div class="rodape"><%= orgNome %> · Painel Interno</div>
  </div>

  <script>
    document.getElementById('form-mfa').addEventListener('submit', function() {
      document.getElementById('btn-verificar').classList.add('loading');
    });
  </script>
</body>
</html>
