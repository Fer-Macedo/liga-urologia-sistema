<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"><link rel="shortcut icon" href="/favicon.ico"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inscrições PSS — LAURO</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin-modern.css">
  <style>
    :root{--cor-primaria:<%= config.org_cor||'#2b6803' %>;--rad:6px;}
    .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:18px;}
    .kpi{background:var(--card);border:1px solid var(--borda);border-radius:var(--rad);padding:14px 16px;}
    .kpi .n{font-size:26px;font-weight:800;color:var(--texto);} .kpi .l{font-size:11px;color:var(--texto2);text-transform:uppercase;letter-spacing:.04em;font-weight:700;}
    .box{background:var(--card);border:1px solid var(--borda);border-radius:var(--rad);padding:16px;margin-bottom:16px;}
    .box h3{font-size:13px;margin-bottom:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--texto2);}
    table{width:100%;border-collapse:collapse;font-size:13px;}
    th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--borda);}
    th{font-size:11px;text-transform:uppercase;color:var(--texto2);letter-spacing:.03em;}
    .badge{padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;}
    .badge.ok{background:#dcfce7;color:#166534;} .badge.pd{background:#fef9c3;color:#854d0e;}
    .num3{font-weight:800;font-family:monospace;font-size:15px;color:var(--cor-primaria);}
    .flex{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;}
    .flex .campo{flex:1;min-width:120px;}
    .link-pub{background:#f0fdf4;border:1px dashed #86efac;border-radius:var(--rad);padding:10px 12px;font-size:12px;font-family:monospace;color:#166534;word-break:break-all;}
    input,select,textarea{padding:9px;border:1px solid var(--borda);border-radius:var(--rad);font-size:13px;width:100%;background:var(--card);color:var(--texto);font-family:inherit;}
    label.lb{font-size:11px;font-weight:700;color:var(--texto2);display:block;margin-bottom:4px;}
    .pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;}
    .pcard{background:var(--card);border:1px solid var(--borda);border-radius:var(--rad);overflow:hidden;transition:.16s;}
    .pcard:hover{border-color:var(--cor-primaria);transform:translateY(-2px);box-shadow:0 8px 20px -10px rgba(0,0,0,.25);}
    .pbanner{width:100%;height:130px;object-fit:cover;display:block;}
    .pbanner-ph{width:100%;height:130px;display:flex;align-items:center;justify-content:center;text-align:center;padding:0 14px;color:#fff;font-weight:800;font-size:15px;letter-spacing:.3px;}
    .pbody{padding:14px 16px;}
    .pnome{font-weight:800;font-size:15px;margin-bottom:6px;color:var(--texto);}
    .pmeta{font-size:12px;color:var(--texto2);margin-bottom:3px;display:flex;gap:6px;align-items:center;}
    .pstatus{display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:800;margin-bottom:8px;}
    .pstatus.aberta{background:#dcfce7;color:#166534;} .pstatus.fechada{background:#fee2e2;color:#b91c1c;}
    .pacoes{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px;}
    .pacoes .btn-sm{font-size:11.5px;padding:6px 10px;}
  </style>
</head>
<body>
<div class="layout">
  <%- include('../partials/sidebar', { paginaAtual: 'inscricoes-pss' }) %>
  <main class="main">
    <div class="topbar">
      <% if (vista==='detalhe' && processo) { %>
        <a href="/inscricoes-pss" class="btn btn-sm" style="text-decoration:none">← Voltar</a>
        <h1 class="page-titulo" style="margin:0;font-size:18px"><%= processo.nome %></h1>
        <div class="topbar-acoes"><button class="btn btn-sm" onclick="abrirModal('modal-editar-proc')">✏️ Editar processo</button></div>
      <% } else { %>
        <h1 class="page-titulo">Inscrições PSS</h1>
        <div class="topbar-acoes"><button class="btn btn-primario btn-sm" onclick="abrirModal('modal-novo-proc')">+ Novo Processo</button></div>
      <% } %>
    </div>
    <div class="content">
      <%if(msg&&msg.length>0){%><div class="alerta alerta-ok"><%=msg[0]%></div><%}%>
      <%if(erro&&erro.length>0){%><div class="alerta alerta-erro"><%=erro[0]%></div><%}%>

      <% if (vista==='lista') { %>
        <% if (!procs.length) { %>
          <div class="box">Nenhum processo cadastrado ainda. Clique em <b>+ Novo Processo</b> pra criar o primeiro (com banner, valor, WhatsApp).</div>
        <% } %>
        <div class="pgrid">
          <% procs.forEach(function(p){ var cor=p.cor_tema||'#2b6803'; %>
            <div class="pcard">
              <% if (p.banner_chave) { %><img class="pbanner" src="/inscricoes-pss/processo/<%=p.id%>/banner" alt="<%=p.nome%>"><% } else { %><div class="pbanner-ph" style="background:linear-gradient(135deg,<%=cor%>,<%=cor%>cc)"><%= p.nome.substring(0,40) %></div><% } %>
              <div class="pbody">
                <span class="pstatus <%= p.inscricoes_abertas?'aberta':'fechada' %>"><%= p.inscricoes_abertas?'Inscrições abertas':'Inscrições fechadas' %></span>
                <div class="pnome"><%= p.nome %></div>
                <div class="pmeta"><%= p.semestre||'' %><%= p.data_prova?(' · Prova '+new Date(p.data_prova).toLocaleDateString('pt-BR',{timeZone:'UTC'})):'' %></div>
                <div class="pmeta"><%= p.total_inscritos||0 %> inscritos · <%= p.confirmados||0 %> confirmados</div>
                <div class="pmeta">Valor: <%= parseFloat(p.valor_inscricao)>0 ? ('R$ '+parseFloat(p.valor_inscricao).toFixed(2).replace('.',',')) : 'Gratuito' %></div>
                <div class="pacoes">
                  <a href="/inscricoes-pss?processo=<%=p.id%>" class="btn btn-primario btn-sm">Gerenciar</a>
                  <a href="<%= inscricaoBase %>/pss/<%=p.id%>/inscricao" target="_blank" class="btn btn-sm">Página</a>
                  <form method="POST" action="/inscricoes-pss/processo/<%=p.id%>/toggle" style="display:inline">
                    <button class="btn btn-sm" style="<%= p.inscricoes_abertas?'color:#b91c1c':'color:#16a34a' %>"><%= p.inscricoes_abertas?'Desativar':'Ativar' %></button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else if (processo) { %>
        <div class="cards">
          <div class="kpi"><div class="n"><%= resumo.total %></div><div class="l">Inscrições</div></div>
          <div class="kpi"><div class="n" style="color:#16a34a"><%= resumo.confirmados %></div><div class="l">Confirmadas</div></div>
          <div class="kpi"><div class="n" style="color:#d97706"><%= resumo.pendentes %></div><div class="l">Pendentes</div></div>
          <div class="kpi"><div class="n">R$ <%= (resumo.arrecadado||0).toFixed(2).replace('.',',') %></div><div class="l">Arrecadado (líq.)</div></div>
        </div>

        <div class="box">
          <h3>Configuração das inscrições</h3>
          <form method="POST" action="/inscricoes-pss/processo/<%=processo.id%>/config" class="flex">
            <div class="campo"><label class="lb">Valor da inscrição (R$)</label><input name="valor_inscricao" type="number" step="0.01" min="0" value="<%= parseFloat(processo.valor_inscricao)||0 %>"></div>
            <div class="campo" style="flex:0 0 auto"><label class="lb">Inscrições abertas?</label>
              <label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;padding-top:6px"><input type="checkbox" name="inscricoes_abertas" style="width:auto" <%= processo.inscricoes_abertas?'checked':'' %>> Abertas</label></div>
            <button class="btn btn-primario btn-sm" type="submit">Salvar</button>
          </form>
          <div style="margin-top:12px"><label class="lb">Link público de inscrição</label>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
              <div class="link-pub" id="link-pub" style="flex:1;min-width:220px"><%= inscricaoBase %>/pss/<%=processo.id%>/inscricao</div>
              <button type="button" class="btn btn-sm" onclick="copiarLink(this)">📋 Copiar link</button>
              <a href="<%= inscricaoBase %>/pss/<%=processo.id%>/inscricao" target="_blank" rel="noopener" class="btn btn-sm">🔗 Abrir link</a>
            </div>
          </div>
        </div>

        <div class="box">
          <h3>Cupons de desconto</h3>
          <form method="POST" action="/inscricoes-pss/processo/<%=processo.id%>/cupom" class="flex" style="margin-bottom:12px">
            <div class="campo"><label class="lb">Código</label><input name="codigo" placeholder="EX: LIGANTE2026" style="text-transform:uppercase" required></div>
            <div class="campo" style="max-width:150px"><label class="lb">Tipo</label><select name="tipo"><option value="percentual">% desconto</option><option value="valor">R$ desconto</option></select></div>
            <div class="campo" style="max-width:110px"><label class="lb">Valor</label><input name="valor" type="number" step="0.01" min="0" placeholder="100 = isento" required></div>
            <div class="campo" style="max-width:90px"><label class="lb">Usos</label><input name="usos_max" type="number" min="1" value="1"></div>
            <button class="btn btn-sm" type="submit">Criar</button>
          </form>
          <table><thead><tr><th>Código</th><th>Desconto</th><th>Usos</th><th>Usado por</th><th></th></tr></thead><tbody>
            <% if(!cupons.length){ %><tr><td colspan="5" style="color:var(--texto2)">Nenhum cupom.</td></tr><% } %>
            <% cupons.forEach(function(c){ %>
              <tr><td style="font-family:monospace;font-weight:700"><%=c.codigo%></td>
                <td><%= c.tipo==='percentual' ? (parseFloat(c.valor)+'%'+(parseFloat(c.valor)>=100?' (isento)':'')) : ('R$ '+parseFloat(c.valor).toFixed(2)) %></td>
                <td><%=c.usos_atual%>/<%=c.usos_max%></td><td><%= c.usado_nome||'—' %></td>
                <td><form method="POST" action="/inscricoes-pss/cupom/<%=c.id%>/deletar" onsubmit="var f=this; confirmarAcao('Remover este cupom?', function(){ f.submit(); }); return false;"><input type="hidden" name="processo_id" value="<%=processo.id%>"><button class="btn btn-sm" style="color:#b91c1c">Remover</button></form></td></tr>
            <% }); %>
          </tbody></table>
        </div>

        <div class="box">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <h3 style="margin:0">Inscritos</h3>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <form method="POST" action="/inscricoes-pss/processo/<%=processo.id%>/lembrete-pendentes" style="display:inline" onsubmit="var f=this; confirmarAcao('Enviar e-mail de lembrete (oferecendo ajuda) a TODOS os inscritos pendentes deste processo?', function(){ f.submit(); }, {textoConfirmar:'Enviar', corConfirmar:'#d97706'}); return false;"><button class="btn btn-sm" style="background:#d97706;color:#fff">✉️ Lembrar pendentes</button></form>
              <a href="/inscricoes-pss/relatorio?processo=<%=processo.id%>" target="_blank" class="btn btn-sm">🖨️ Gerar relatório</a>
            </div>
          </div>
          <div class="flex" style="margin-bottom:12px">
            <div class="campo"><input id="fbusca" placeholder="Buscar por nome, documento ou e-mail…" oninput="filtrarInsc()"></div>
            <div class="campo" style="max-width:170px"><select id="fstatus" onchange="filtrarInsc()"><option value="">Todos os status</option><option value="confirmado">Confirmado</option><option value="pendente">Pendente</option></select></div>
            <div class="campo" style="max-width:150px"><label class="lb">Inscrito de</label><input id="fde" type="date" onchange="filtrarInsc()"></div>
            <div class="campo" style="max-width:150px"><label class="lb">até</label><input id="fate" type="date" onchange="filtrarInsc()"></div>
          </div>
          <div style="overflow-x:auto"><table>
            <thead><tr><th>Nº</th><th>Nome</th><th>Documento</th><th>E-mail</th><th>Inscrito em</th><th>Status</th><th>Valor</th><th>Ações</th></tr></thead><tbody>
              <% if(!inscritos.length){ %><tr><td colspan="8" style="color:var(--texto2)">Nenhuma inscrição ainda.</td></tr><% } %>
              <tr id="sem-resultado" style="display:none"><td colspan="8" style="color:var(--texto2)">Nenhum resultado para o filtro.</td></tr>
              <% inscritos.forEach(function(i){ var conf=i.pagamento_status==='confirmado';
                var nomeExibido = formatarNome(i.nome);
              %>
                <tr class="insc-row" data-status="<%=i.pagamento_status%>" data-data="<%= i.criado_em ? new Date(i.criado_em).toISOString().slice(0,10) : '' %>" data-busca="<%=(i.nome+' '+(i.documento||'')+' '+(i.email||'')).toLowerCase().replace(/"/g,'')%>">
                  <td><span class="num3"><%= i.numero_lista?String(i.numero_lista).padStart(3,'0'):'—' %></span></td>
                  <td><%=nomeExibido%></td>
                  <td><%= (i.documento_tipo||'')+' '+(i.documento||'') %></td>
                  <td style="font-size:12px"><%=i.email%></td>
                  <td style="font-size:12px;white-space:nowrap"><%= i.criado_em ? new Date(i.criado_em).toLocaleDateString('pt-BR') : '—' %></td>
                  <td><span class="badge <%=conf?'ok':'pd'%>"><%= conf?'Confirmado':'Pendente' %></span><%- i.isento?' <span class="badge" style="background:#e0e7ff;color:#3730a3">isento</span>':'' %></td>
                  <td><%= i.valor_pago!=null ? ('R$ '+(parseFloat(i.valor_pago)||0).toFixed(2).replace('.',',')) : '—' %></td>
                  <td style="white-space:nowrap">
                    <% if(!conf){ %><form method="POST" action="/inscricoes-pss/candidato/<%=i.id%>/confirmar-manual" style="display:inline" onsubmit="var f=this; confirmarAcao('Confirmar esta inscrição manualmente (ex.: pagamento em dinheiro)? Será atribuído o número e lançado no fluxo de caixa.', function(){ f.submit(); }, {textoConfirmar:'Confirmar', corConfirmar:'#16a34a'}); return false;"><input type="hidden" name="processo_id" value="<%=processo.id%>"><button class="btn btn-sm" style="background:#16a34a;color:#fff">Confirmar</button></form>
                    <form method="POST" action="/inscricoes-pss/candidato/<%=i.id%>/lembrete" style="display:inline" onsubmit="var f=this; confirmarAcao('Enviar e-mail de lembrete a este candidato, oferecendo ajuda para concluir a inscrição?', function(){ f.submit(); }, {textoConfirmar:'Enviar', corConfirmar:'#d97706'}); return false;"><input type="hidden" name="processo_id" value="<%=processo.id%>"><button class="btn btn-sm" style="color:#d97706">Lembrete</button></form><% } else { %>
                    <form method="POST" action="/inscricoes-pss/candidato/<%=i.id%>/reenviar-email" style="display:inline"><input type="hidden" name="processo_id" value="<%=processo.id%>"><button class="btn btn-sm">Reenviar e-mail</button></form><% } %>
                    <button type="button" class="btn btn-sm" onclick="verInsc(<%=i.id%>)">Visualizar</button>
                    <button type="button" class="btn btn-sm" onclick="editarInsc(<%=i.id%>)">Editar</button>
                    <form method="POST" action="/inscricoes-pss/candidato/<%=i.id%>/excluir" style="display:inline" onsubmit="var f=this; confirmarAcao('Excluir DEFINITIVAMENTE esta inscrição? Esta ação não pode ser desfeita.', function(){ f.submit(); }); return false;"><input type="hidden" name="processo_id" value="<%=processo.id%>"><button class="btn btn-sm" style="color:#b91c1c">Excluir</button></form>
                  </td>
                </tr>
              <% }); %>
            </tbody></table></div>
        </div>
      <% } %>
    </div>
  </main>
</div>

<% if (processo) { %>
<div class="modal-overlay" id="modal-ver-insc" style="display:none">
  <div class="modal" style="max-width:540px">
    <div class="modal-header"><span class="modal-titulo">Dados da Inscrição</span><button class="icon-btn" onclick="fecharModal('modal-ver-insc')">&#x2715;</button></div>
    <div class="modal-body" style="padding:20px 24px;display:flex;flex-direction:column;gap:10px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><label class="label">Nome</label><div id="vi-nome" style="font-weight:600"></div></div>
        <div><label class="label">Nº de inscrição</label><div id="vi-numero"></div></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><label class="label">E-mail</label><div id="vi-email"></div></div>
        <div><label class="label">WhatsApp</label><div id="vi-telefone"></div></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><label class="label">Documento</label><div id="vi-documento"></div></div>
        <div><label class="label">Data de nascimento</label><div id="vi-nascimento"></div></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><label class="label">Curso / Semestre</label><div id="vi-curso"></div></div>
        <div><label class="label">Turma / Fila / Catraca</label><div id="vi-turma"></div></div>
      </div>
      <hr style="border:none;border-top:1px solid var(--borda);margin:4px 0">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><label class="label">Status do pagamento</label><div id="vi-status"></div></div>
        <div><label class="label">Valor pago</label><div id="vi-valor"></div></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><label class="label">Cupom</label><div id="vi-cupom"></div></div>
        <div><label class="label">E-mail de confirmação</label><div id="vi-email-enviado"></div></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><label class="label">Inscrito em</label><div id="vi-criado"></div></div>
        <div><label class="label">Confirmado em</label><div id="vi-confirmado"></div></div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn" onclick="fecharModal('modal-ver-insc')">Fechar</button>
      <button type="button" class="btn btn-primario" id="vi-btn-editar">Editar</button>
    </div>
  </div>
</div>
<div class="modal-overlay" id="modal-editar-insc" style="display:none">
  <div class="modal" style="max-width:540px">
    <div class="modal-header"><span class="modal-titulo">Editar Inscrição</span><button class="icon-btn" onclick="fecharModal('modal-editar-insc')">&#x2715;</button></div>
    <form id="form-editar-insc" method="POST">
      <input type="hidden" name="processo_id" value="<%=processo.id%>">
      <div class="modal-body" style="padding:20px 24px;display:flex;flex-direction:column;gap:12px">
        <div class="campo"><label class="label">Nome *</label><input name="nome" id="ei-nome" class="input" required></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="campo"><label class="label">E-mail *</label><input name="email" id="ei-email" type="email" class="input" required></div>
          <div class="campo"><label class="label">WhatsApp</label><input name="telefone" id="ei-telefone" class="input"></div>
        </div>
        <div style="display:grid;grid-template-columns:130px 1fr;gap:10px">
          <div class="campo"><label class="label">Tipo doc.</label><select name="documento_tipo" id="ei-doctipo" class="input"><option>CPF</option><option>CI</option><option>DNI</option></select></div>
          <div class="campo"><label class="label">Documento</label><input name="documento" id="ei-documento" class="input"></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="campo"><label class="label">Curso</label><input name="curso" id="ei-curso" class="input"></div>
          <div class="campo"><label class="label">Semestre</label><input name="semestre_atual" id="ei-semestre" class="input" inputmode="numeric"></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="campo"><label class="label">Número (até 3 díg)</label><input name="numero_lista" id="ei-numero" class="input" inputmode="numeric" placeholder="ex: 12"></div>
          <div class="campo"><label class="label">Fila da prova</label><select name="fila_prova" id="ei-fila" class="input"><option value="">—</option><option>A</option><option>B</option><option>C</option></select></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="fecharModal('modal-editar-insc')">Cancelar</button>
        <button type="submit" class="btn btn-primario">Salvar Alterações</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<div class="modal-overlay" id="modal-novo-proc" style="display:none">
  <div class="modal" style="max-width:560px">
    <div class="modal-header"><span class="modal-titulo">Novo Processo Seletivo</span><button class="icon-btn" onclick="fecharModal('modal-novo-proc')">&#x2715;</button></div>
    <form method="POST" action="/inscricoes-pss/criar" enctype="multipart/form-data">
      <div class="modal-body" style="padding:20px 24px;display:flex;flex-direction:column;gap:12px">
        <div class="campo"><label class="lb">Nome do processo *</label><input name="nome" required placeholder="Ex: Processo Seletivo 2026.2"></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="campo"><label class="lb">Semestre</label><input name="semestre" placeholder="2026.2"></div>
          <div class="campo"><label class="lb">Data da prova</label><input type="date" name="data_prova"></div>
        </div>
        <div class="campo"><label class="lb">Local da prova</label><input name="local_prova"></div>
        <div style="display:grid;grid-template-columns:1fr auto;gap:10px">
          <div class="campo"><label class="lb">Valor da inscrição (R$)</label><input name="valor_inscricao" type="number" step="0.01" min="0" value="0"></div>
          <div class="campo"><label class="lb">Cor</label><input name="cor_tema" type="color" value="#2b6803" style="height:38px;padding:3px;width:56px"></div>
        </div>
        <div class="campo"><label class="lb">Banner (imagem)</label><input type="file" name="banner" accept="image/*"><small style="display:block;margin-top:4px;color:#6b7280;font-size:11px">📐 Tamanho recomendado: <b>1200 × 400 px</b> (proporção 3:1, horizontal). Formatos JPG ou PNG. A imagem ocupa toda a largura do topo da página.</small></div>
        <div class="campo"><label class="lb">Edital (PDF)</label><input type="file" name="edital" accept="application/pdf"><small style="display:block;margin-top:4px;color:#6b7280;font-size:11px">📄 Documento oficial do processo. Vira um link público bem visível na página de inscrição.</small></div>
        <div class="campo"><label class="lb">Grupo de WhatsApp (link)</label><input name="wpp_grupo" placeholder="https://chat.whatsapp.com/..."></div>
        <div class="campo"><label class="lb">Descrição (aparece na página pública)</label><textarea name="descricao" rows="3"></textarea></div>
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600"><input type="checkbox" name="inscricoes_abertas" style="width:auto"> Já abrir inscrições</label>
      </div>
      <div class="modal-footer"><button type="button" class="btn" onclick="fecharModal('modal-novo-proc')">Cancelar</button><button type="submit" class="btn btn-primario">Criar Processo</button></div>
    </form>
  </div>
</div>
<% if (vista==='detalhe' && processo) { %>
<div class="modal-overlay" id="modal-editar-proc" style="display:none">
  <div class="modal" style="max-width:560px">
    <div class="modal-header"><span class="modal-titulo">Editar Processo</span><button class="icon-btn" onclick="fecharModal('modal-editar-proc')">&#x2715;</button></div>
    <form method="POST" action="/inscricoes-pss/processo/<%=processo.id%>/editar-dados" enctype="multipart/form-data">
      <div class="modal-body" style="padding:20px 24px;display:flex;flex-direction:column;gap:12px">
        <div class="campo"><label class="lb">Nome *</label><input name="nome" value="<%=processo.nome%>" required></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="campo"><label class="lb">Semestre</label><input name="semestre" value="<%=processo.semestre||''%>"></div>
          <div class="campo"><label class="lb">Data da prova</label><input type="date" name="data_prova" value="<%= processo.data_prova?new Date(processo.data_prova).toISOString().slice(0,10):'' %>"></div>
        </div>
        <div class="campo"><label class="lb">Local da prova</label><input name="local_prova" value="<%=processo.local_prova||''%>"></div>
        <div class="campo"><label class="lb">Cor do tema</label><input name="cor_tema" type="color" value="<%=processo.cor_tema||'#2b6803'%>" style="height:38px;padding:3px;width:56px"></div>
        <div class="campo"><label class="lb">Trocar banner (deixe vazio p/ manter)</label><input type="file" name="banner" accept="image/*"><small style="display:block;margin-top:4px;color:#6b7280;font-size:11px">📐 Tamanho recomendado: <b>1200 × 400 px</b> (proporção 3:1, horizontal). Formatos JPG ou PNG. A imagem ocupa toda a largura do topo da página.</small></div>
        <div class="campo"><label class="lb">Edital (PDF) <%if(processo.edital_chave){%><a href="/inscricoes-pss/processo/<%=processo.id%>/edital" target="_blank" style="font-size:11px;margin-left:6px">📄 ver atual</a><%}%></label><input type="file" name="edital" accept="application/pdf"><small style="display:block;margin-top:4px;color:#6b7280;font-size:11px">Deixe vazio p/ manter o atual. Vira um link público na página de inscrição.</small></div>
        <div class="campo"><label class="lb">Grupo de WhatsApp (link)</label><input name="wpp_grupo" value="<%=processo.wpp_grupo||''%>"></div>
        <div class="campo"><label class="lb">Descrição</label><textarea name="descricao" rows="3"><%=processo.descricao||''%></textarea></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn" onclick="fecharModal('modal-editar-proc')">Cancelar</button><button type="submit" class="btn btn-primario">Salvar</button></div>
    </form>
  </div>
</div>
<% } %>
<script src="/js/app.js"></script>
<script>
function filtrarInsc(){
  var q=(document.getElementById('fbusca').value||'').toLowerCase().trim();
  var st=document.getElementById('fstatus').value;
  var de=document.getElementById('fde').value, ate=document.getElementById('fate').value, vis=0;
  document.querySelectorAll('.insc-row').forEach(function(r){
    var okQ=!q||(r.getAttribute('data-busca')||'').indexOf(q)>=0;
    var okS=!st||r.getAttribute('data-status')===st;
    var d=r.getAttribute('data-data')||'';
    var okD=(!de||(d&&d>=de))&&(!ate||(d&&d<=ate));
    var ok=okQ&&okS&&okD; r.style.display=ok?'':'none'; if(ok)vis++;
  });
  var sr=document.getElementById('sem-resultado'); if(sr) sr.style.display=(vis===0)?'':'none';
}
var INSCRITOS=<%- JSON.stringify(inscritos.map(function(i){return {id:i.id,nome:i.nome,email:i.email,telefone:i.telefone,documento_tipo:i.documento_tipo,documento:i.documento,curso:i.curso,semestre_atual:i.semestre_atual,numero_lista:i.numero_lista,fila_prova:i.fila_prova,
  data_nascimento:i.data_nascimento,catraca:i.catraca,turma:i.turma,pagamento_status:i.pagamento_status,valor_pago:i.valor_pago,isento:i.isento,cupom_codigo:i.cupom_codigo,
  email_confirmacao_enviado:i.email_confirmacao_enviado,criado_em:i.criado_em,confirmado_em:i.confirmado_em};})).replace(/</g,'\\u003c') %>;
function verInsc(id){
  var i=INSCRITOS.find(function(x){return x.id===id;}); if(!i)return;
  document.getElementById('vi-nome').textContent=i.nome||'—';
  document.getElementById('vi-numero').textContent=i.numero_lista?String(i.numero_lista).padStart(3,'0'):'—';
  document.getElementById('vi-email').textContent=i.email||'—';
  document.getElementById('vi-telefone').textContent=i.telefone||'—';
  document.getElementById('vi-documento').textContent=(i.documento_tipo||'')+' '+(i.documento||'—');
  document.getElementById('vi-nascimento').textContent=i.data_nascimento?new Date(i.data_nascimento).toLocaleDateString('pt-BR',{timeZone:'UTC'}):'—';
  document.getElementById('vi-curso').textContent=(i.curso||'—')+(i.semestre_atual?(' / '+i.semestre_atual+'º sem.'):'');
  document.getElementById('vi-turma').textContent=[i.turma,i.fila_prova?('fila '+i.fila_prova):'',i.catraca].filter(Boolean).join(' / ')||'—';
  document.getElementById('vi-status').textContent=(i.pagamento_status==='confirmado'?'Confirmado':'Pendente')+(i.isento?' (isento)':'');
  document.getElementById('vi-valor').textContent=i.valor_pago!=null?('R$ '+(parseFloat(i.valor_pago)||0).toFixed(2).replace('.',',')):'—';
  document.getElementById('vi-cupom').textContent=i.cupom_codigo||'—';
  document.getElementById('vi-email-enviado').textContent=i.email_confirmacao_enviado?'Enviado':'Não enviado';
  document.getElementById('vi-criado').textContent=i.criado_em?new Date(i.criado_em).toLocaleString('pt-BR'):'—';
  document.getElementById('vi-confirmado').textContent=i.confirmado_em?new Date(i.confirmado_em).toLocaleString('pt-BR'):'—';
  document.getElementById('vi-btn-editar').onclick=function(){ fecharModal('modal-ver-insc'); editarInsc(id); };
  abrirModal('modal-ver-insc');
}
function editarInsc(id){
  var i=INSCRITOS.find(function(x){return x.id===id;}); if(!i)return;
  document.getElementById('form-editar-insc').action='/inscricoes-pss/candidato/'+id+'/editar';
  document.getElementById('ei-nome').value=i.nome||'';
  document.getElementById('ei-email').value=i.email||'';
  document.getElementById('ei-telefone').value=i.telefone||'';
  document.getElementById('ei-doctipo').value=i.documento_tipo||'CPF';
  document.getElementById('ei-documento').value=i.documento||'';
  document.getElementById('ei-curso').value=i.curso||'';
  document.getElementById('ei-semestre').value=i.semestre_atual||'';
  document.getElementById('ei-numero').value=i.numero_lista||'';
  document.getElementById('ei-fila').value=i.fila_prova||'';
  abrirModal('modal-editar-insc');
}
function copiarLink(btn){
  var t=(document.getElementById('link-pub').textContent||'').trim();
  function ok(){ var o=btn.textContent; btn.textContent='✅ Copiado'; setTimeout(function(){btn.textContent=o;},1500); }
  if(navigator.clipboard&&navigator.clipboard.writeText){ navigator.clipboard.writeText(t).then(ok).catch(function(){prompt('Copie o link:',t);}); }
  else { prompt('Copie o link:',t); }
}
</script>
</body>
</html>
