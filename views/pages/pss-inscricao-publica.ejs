<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inscripción — <%= processo.nome %></title>
  <style>
    :root{--cor:<%= (processo && processo.cor_tema) || (config && config.org_cor) || '#1a3d2b' %>;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:system-ui,-apple-system,Segoe UI,Arial,sans-serif;background:#0f172a;color:#0f172a;min-height:100vh;padding:20px;}
    .wrap{max-width:560px;margin:0 auto;}
    .card{background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 10px 40px rgba(0,0,0,.3);}
    .head{background:var(--cor);color:#fff;padding:26px 24px;}
    .head .k{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;opacity:.8;}
    .head h1{font-size:21px;margin-top:6px;line-height:1.25;}
    .body{padding:24px;}
    .valor{background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px 16px;margin-bottom:18px;text-align:center;}
    .valor b{font-size:26px;color:var(--cor);}
    label{display:block;font-size:12px;font-weight:700;color:#475569;margin:14px 0 5px;text-transform:uppercase;letter-spacing:.03em;}
    input,select{width:100%;padding:12px;border:1px solid #cbd5e1;border-radius:8px;font-size:15px;color:#0f172a;background:#fff;}
    .row{display:flex;gap:10px;}.row>div{flex:1;}
    .doc{display:flex;gap:8px;}.doc select{max-width:110px;}
    .btn{width:100%;margin-top:22px;padding:15px;border:none;border-radius:8px;background:var(--cor);color:#fff;font-size:16px;font-weight:800;cursor:pointer;}
    .btn:disabled{opacity:.6;}
    .erro{background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px;border-radius:8px;font-size:14px;font-weight:600;margin-bottom:16px;}
    .ok{text-align:center;padding:12px 0;}
    .ok .num{font-size:52px;font-weight:900;color:var(--cor);letter-spacing:5px;margin:10px 0;}
    .mut{font-size:12px;color:#94a3b8;margin-top:6px;}
    .fechado{text-align:center;padding:30px 10px;color:#64748b;font-weight:600;}
  </style>
</head>
<body>
  <div class="wrap"><div class="card">
    <% if (processo.banner_chave) { %><img src="/pss/<%=processo.id%>/banner" style="width:100%;height:170px;object-fit:cover;display:block" alt="<%=processo.nome%>"><% } %>
    <div class="head"><div class="k">Proceso Selectivo · Inscripción</div><h1><%= processo.nome %></h1></div>
    <div class="body">
      <% if (sucesso) { %>
        <div class="ok">
          <div style="font-size:38px">✅</div>
          <h2 style="color:var(--cor);margin-top:8px">¡Inscripción confirmada!</h2>
          <p class="mut" style="margin-top:10px">Su número de inscripción</p>
          <div class="num"><%= String(numero).padStart(3,'0') %></div>
          <p style="font-size:13px;color:#475569">Guarde este número. Deberá completarlo en la hoja de respuestas el día del examen. Le enviamos también la confirmación por correo.</p>
          <% if (processo.wpp_grupo) { %><a href="<%= processo.wpp_grupo %>" target="_blank" rel="noopener" style="display:inline-block;margin-top:16px;background:#25d366;color:#fff;padding:12px 26px;border-radius:8px;text-decoration:none;font-weight:700;font-size:14px">Entrar en el grupo de WhatsApp</a><% } %>
        </div>
      <% } else if (!processo.inscricoes_abertas) { %>
        <div class="fechado">Las inscripciones para este proceso están cerradas.<br><span class="mut">As inscrições para este processo estão encerradas.</span></div>
      <% } else { %>
        <% if (typeof erro !== 'undefined' && erro) { %><div class="erro"><%= erro %></div><% } %>
        <% if (processo.descricao) { %><p style="font-size:14px;color:#475569;line-height:1.55;margin-bottom:16px;white-space:pre-line"><%= processo.descricao %></p><% } %>
        <% var _v = parseFloat(processo.valor_inscricao)||0; %>
        <div class="valor"><div class="mut" style="margin:0 0 4px">Valor de la inscripción</div><b><%= _v>0 ? ('R$ '+_v.toFixed(2).replace('.',',')) : 'Gratuito' %></b></div>
        <form method="POST" action="/pss/<%= processo.id %>/inscricao" onsubmit="document.getElementById('bt').disabled=true;document.getElementById('bt').textContent='Procesando…'">
          <label>Nombre completo / Nome completo *</label>
          <input name="nome" required maxlength="120" autocomplete="name">
          <label>Correo electrónico / E-mail *</label>
          <input name="email" type="email" required autocomplete="email">
          <label>WhatsApp</label>
          <input name="whatsapp" inputmode="tel" placeholder="+595 ...">
          <label>Documento *</label>
          <div class="doc">
            <select name="documento_tipo"><option value="CPF">CPF</option><option value="CI">C.I.</option><option value="DNI">DNI</option></select>
            <input name="documento" required placeholder="Número del documento">
          </div>
          <div class="row">
            <div><label>Curso / Facultad</label><input name="curso" placeholder="Medicina"></div>
            <div><label>Semestre</label><input name="semestre_atual" inputmode="numeric" placeholder="Ej: 5"></div>
          </div>
          <label>Cupón de descuento (opcional)</label>
          <input name="cupom_codigo" value="<%= typeof cupomUrl!=='undefined'?cupomUrl:'' %>" style="text-transform:uppercase" placeholder="Código">
          <button class="btn" id="bt" type="submit"><%= _v>0 ? 'Continuar al pago' : 'Confirmar inscripción' %></button>
          <p class="mut" style="text-align:center">Cada persona puede inscribirse una sola vez por proceso.</p>
        </form>
      <% } %>
    </div>
  </div></div>
</body>
</html>
