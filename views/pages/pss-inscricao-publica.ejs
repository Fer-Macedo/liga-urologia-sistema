<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <link rel="shortcut icon" href="/favicon.ico"><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= processo.nome %> — LAURO</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --p: <%= (processo && processo.cor_tema)||'#1a3d2b' %>;
      --p-light: color-mix(in srgb,<%= (processo && processo.cor_tema)||'#1a3d2b' %> 8%,white);
      --p-mid: color-mix(in srgb,<%= (processo && processo.cor_tema)||'#1a3d2b' %> 18%,white);
      --ink: #111827; --ink2: #374151; --ink3: #6b7280; --ink4: #9ca3af;
      --sur: #ffffff; --sur2: #f5f5f0; --sur3: #f3f4f6;
      --bdr: #e5e7eb; --bdr2: #d1d5db;
      --sh: 0 1px 3px rgba(0,0,0,.06),0 4px 12px rgba(0,0,0,.05);
      --sh-sm: 0 1px 2px rgba(0,0,0,.05);
      --sh-lg: 0 10px 40px rgba(0,0,0,.12),0 2px 8px rgba(0,0,0,.06);
      --r: 4px; --r-sm: 2px; --r-lg: 4px;
    }
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',sans-serif;background:var(--sur2);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
    nav{background:rgba(255,255,255,.93);backdrop-filter:blur(20px);border-bottom:1px solid var(--bdr);position:sticky;top:0;z-index:200}
    .nav-in{max-width:1160px;margin:0 auto;padding:0 28px;height:62px;display:flex;align-items:center;justify-content:space-between}
    .nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none}
    .nav-logo-txt{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:26px;color:var(--p);letter-spacing:2px}
    .nav-links{display:flex;gap:6px;align-items:center}
    .nav-a{font-size:13px;font-weight:500;color:var(--ink2);text-decoration:none;padding:6px 12px;border-radius:2px;transition:background .18s,color .18s}
    .nav-a:hover{background:var(--sur3);color:var(--ink)}
    .nav-cta{background:var(--p);color:white;padding:8px 20px;border-radius:2px;font-size:13px;font-weight:600;text-decoration:none;transition:opacity .18s,transform .18s}
    .nav-cta:hover{opacity:.88;transform:translateY(-1px)}
    .banner-wrap{width:100%;position:relative;background:var(--ink);overflow:hidden;max-height:440px}
    .title-wrap{background:var(--sur);border-bottom:1px solid var(--bdr);padding:28px 0 24px}
    .title-in{max-width:1160px;margin:0 auto;padding:0 28px}
    .event-tag{display:inline-flex;align-items:center;gap:6px;background:var(--p-light);color:var(--p);border:1px solid color-mix(in srgb,var(--p) 20%,transparent);border-radius:20px;padding:4px 12px;font-size:11px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;margin-bottom:12px}
    .event-tag svg{width:12px;height:12px;fill:currentColor}
    .title-in h1{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(20px,3.5vw,34px);font-weight:800;color:var(--ink);line-height:1.2;letter-spacing:-.5px;margin-bottom:14px}
    .title-meta{display:flex;flex-wrap:wrap;gap:20px}
    .t-chip{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink2);font-weight:500}
    .t-chip-icon{width:28px;height:28px;border-radius:7px;background:var(--sur3);display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .t-chip-icon svg{width:14px;height:14px;fill:var(--ink3)}
    .edital-btn{display:inline-flex;align-items:center;gap:10px;margin-top:16px;padding:10px 18px;background:var(--p-light);border:1px solid color-mix(in srgb,var(--p) 22%,transparent);border-radius:4px;text-decoration:none;transition:background .18s,transform .18s}
    .edital-btn:hover{background:var(--p-mid);transform:translateY(-1px)}
    .edital-btn svg{width:18px;height:18px;fill:var(--p);flex-shrink:0}
    .edital-btn .lbl{display:flex;flex-direction:column;font-size:13px;font-weight:700;color:var(--p);line-height:1.3}
    .edital-btn .lbl small{font-size:11px;font-weight:500;color:var(--ink3)}
    .wpp-banner{background:linear-gradient(90deg,#0a7a6e 0%,#25d366 100%);padding:13px 0}
    .wpp-in{max-width:1160px;margin:0 auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}
    .wpp-txt{color:white;font-size:13px;font-weight:500;display:flex;align-items:center;gap:9px}
    .wpp-txt svg{width:18px;height:18px;fill:white;flex-shrink:0}
    .wpp-join{background:white;color:#0a7a6e;padding:7px 18px;border-radius:2px;font-weight:700;font-size:13px;text-decoration:none;display:flex;align-items:center;gap:6px;white-space:nowrap}
    .wpp-join svg{width:14px;height:14px;fill:#0a7a6e}
    .wrap{max-width:1160px;margin:0 auto;padding:32px 28px 80px}
    .grid{display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:start}
    @media(max-width:920px){.grid{grid-template-columns:1fr}.sidebar{order:2}}
    @media(max-width:600px){.wrap{padding:20px 16px 60px}.nav-in{padding:0 16px}}
    .card{background:var(--sur);border-radius:4px;box-shadow:var(--sh);border:1px solid var(--bdr);overflow:hidden;margin-bottom:20px}
    .card-hd{padding:20px 26px 16px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;gap:10px}
    .card-hd-ic{width:32px;height:32px;border-radius:8px;background:var(--p-light);display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .card-hd-ic svg{width:15px;height:15px;fill:var(--p)}
    .card-hd h2{font-size:12px;font-weight:700;color:var(--ink2);letter-spacing:.8px;text-transform:uppercase}
    .card-bd{padding:22px 26px}
    .sec-title{font-size:11px;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:.8px;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--bdr)}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media(max-width:500px){.grid2{grid-template-columns:1fr}}
    .campo{margin-bottom:14px}
    .campo label{display:block;font-size:11px;font-weight:600;color:var(--ink2);margin-bottom:5px;letter-spacing:.2px}
    .req{color:#ef4444}
    .inp{width:100%;padding:11px 13px;border:1.5px solid var(--bdr);border-radius:2px;font-size:13px;font-family:'Inter',sans-serif;color:var(--ink);background:var(--sur);transition:border-color .18s,box-shadow .18s}
    .inp:focus{outline:none;border-color:var(--p);box-shadow:0 0 0 3px var(--p-light)}
    .inp::placeholder{color:var(--ink4)}
    .doc-row{display:flex;gap:8px}.doc-row select{max-width:120px}
    .cupom-in{font-family:'DM Mono',monospace;letter-spacing:1px;text-transform:uppercase}
    .btn-sub{width:100%;padding:16px;background:var(--p);color:white;border:none;border-radius:2px;font-size:15px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;margin-top:8px;transition:background .2s}
    .btn-sub:hover{background:#0F6E56}
    .btn-sub:disabled{opacity:.6}
    .secure-note{text-align:center;font-size:11px;color:var(--ink4);margin-top:12px}
    .resumo-card{border-radius:4px;padding:22px;margin-bottom:18px;color:white;position:relative;overflow:hidden;background:linear-gradient(135deg,var(--p) 0%,color-mix(in srgb,var(--p) 75%,#000) 100%);box-shadow:0 8px 28px color-mix(in srgb,var(--p) 35%,transparent)}
    .resumo-card::before{content:'';position:absolute;top:-40px;right:-40px;width:160px;height:160px;border-radius:50%;background:rgba(255,255,255,.07)}
    .resumo-eyebrow{font-size:10px;font-weight:700;opacity:.7;text-transform:uppercase;letter-spacing:.8px;margin-bottom:5px}
    .resumo-nome{font-weight:700;font-size:17px;position:relative;z-index:1;line-height:1.3}
    .resumo-preco{font-size:36px;font-weight:900;margin-top:8px;position:relative;z-index:1;letter-spacing:-1px;line-height:1}
    .resumo-divider{height:1px;background:rgba(255,255,255,.18);margin:14px 0;position:relative;z-index:1}
    .resumo-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;background:white;color:var(--p);border-radius:2px;font-weight:700;font-size:14px;text-decoration:none;cursor:pointer;border:none;width:100%;font-family:'Inter',sans-serif;position:relative;z-index:1}
    .s-card{background:var(--sur);border-radius:4px;box-shadow:var(--sh);border:1px solid var(--bdr);padding:22px;margin-bottom:18px}
    .s-title{font-size:10px;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:.8px;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--bdr)}
    .info-it{display:flex;gap:12px;align-items:flex-start;margin-bottom:14px}
    .info-it:last-child{margin-bottom:0}
    .i-icon{width:36px;height:36px;border-radius:2px;background:var(--sur3);display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .i-icon svg{width:16px;height:16px;fill:var(--p)}
    .i-lbl{font-size:10px;color:var(--ink3);font-weight:700;text-transform:uppercase;letter-spacing:.5px}
    .i-val{font-weight:600;font-size:13px;color:var(--ink);margin-top:2px}
    .erro-box{background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:4px;font-size:13px;font-weight:600;margin-bottom:16px}
    .fechado-card{max-width:640px;margin:40px auto;background:#fff;border:1px solid var(--bdr);border-radius:8px;padding:40px 32px;text-align:center;box-shadow:var(--sh-lg)}
    .fechado-card h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:22px;color:var(--ink);margin-bottom:8px}
    .fechado-card p{color:var(--ink3);font-size:14px}
    .suc-wrap{min-height:70vh;display:flex;align-items:center;justify-content:center;padding:40px 20px}
    .suc-box{background:var(--sur);border-radius:8px;box-shadow:var(--sh-lg);padding:48px 36px;text-align:center;max-width:480px;width:100%;border:1px solid var(--bdr)}
    .suc-icon{width:76px;height:76px;background:var(--p);border-radius:4px;display:flex;align-items:center;justify-content:center;margin:0 auto 22px;animation:popIn .5s cubic-bezier(.34,1.56,.64,1)}
    .suc-icon svg{width:38px;height:38px;fill:white}
    @keyframes popIn{0%{transform:scale(0);opacity:0}100%{transform:scale(1);opacity:1}}
    .suc-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:26px;font-weight:700;color:var(--ink);margin-bottom:10px}
    .suc-sub{font-size:14px;color:var(--ink2);line-height:1.6;margin-bottom:22px}
    .suc-cod{background:var(--p-light);border:1px solid color-mix(in srgb,var(--p) 25%,transparent);border-radius:8px;padding:16px 20px;margin-bottom:8px}
    .suc-cod .n{font-size:46px;font-weight:900;color:var(--p);letter-spacing:6px;line-height:1}
    .suc-cod-lbl{font-size:11px;color:var(--ink4);margin-bottom:24px}
    .suc-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;border-radius:2px;text-decoration:none;font-weight:700;font-size:14px;margin-bottom:10px;border:none;cursor:pointer;font-family:'Inter',sans-serif;width:100%}
    .suc-btn-wpp{background:#25d366;color:white}
    .suc-btn svg{width:18px;height:18px;fill:currentColor}
    .wpp-float{position:fixed;bottom:26px;right:26px;z-index:998;width:54px;height:54px;background:#25d366;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,211,102,.4);text-decoration:none;transition:transform .2s}
    .wpp-float:hover{transform:scale(1.1)}
    .wpp-float svg{width:26px;height:26px;fill:white}
    footer{background:var(--ink);color:rgba(255,255,255,.45);text-align:center;padding:32px 20px;font-size:12px;margin-top:40px}
    footer strong{color:rgba(255,255,255,.85)}
    footer a{color:rgba(255,255,255,.6);text-decoration:none}
    footer a:hover{color:#fff}
    .foot-social{display:flex;gap:12px;justify-content:center;margin-bottom:18px}
    .foot-social a{width:42px;height:42px;border-radius:2px;display:flex;align-items:center;justify-content:center;transition:transform .18s,box-shadow .18s}
    .foot-social a:hover{transform:translateY(-3px)}
    .foot-social svg{width:20px;height:20px;fill:white}
    .fs-wa{background:linear-gradient(135deg,#0a7a6e,#25d366)}
    .fs-ig{background:linear-gradient(45deg,#f09433,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888)}
    .fs-yt{background:linear-gradient(135deg,#c4302b,#ff4444 60%,#ff8080)}
  </style>
</head>
<body>
