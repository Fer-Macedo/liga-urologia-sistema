<% var IG='<svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>'; %>
<% var YT='<svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>'; %>
<% var _v = parseFloat(processo.valor_inscricao)||0; %>

<nav><div class="nav-in">
  <a href="/pss/<%= processo.id %>/inscricao" class="nav-logo">
    <% if(config&&config.org_logo){ %><img src="<%= config.org_logo %>" alt="LAURO" style="width:42px;height:42px;object-fit:contain;border-radius:10px"><% } %>
    <span class="nav-logo-txt">LAURO</span>
  </a>
  <div class="nav-links">
    <a href="https://www.instagram.com/lauroucp.cde/" target="_blank" class="nav-a">Instagram</a>
    <a href="#inscripcion" class="nav-cta">Inscribirse</a>
  </div>
</div></nav>

<% if (sucesso) { %>
  <div class="suc-wrap"><div class="suc-box">
    <div class="suc-icon"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg></div>
    <div class="suc-title">¡Inscripción confirmada!</div>
    <p class="suc-sub">Tu inscripción en <strong><%= processo.nome %></strong> fue confirmada. Recibirás la confirmación por correo.</p>
    <div class="suc-cod"><div style="font-size:11px;color:var(--ink3);font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Tu número de inscripción</div><div class="n"><%= String(numero).padStart(3,'0') %></div></div>
    <p class="suc-cod-lbl">Guardá este número. Deberás completarlo en la hoja de respuestas el día del examen.</p>
    <% if(processo.wpp_grupo){ %><a href="<%= processo.wpp_grupo %>" target="_blank" class="suc-btn suc-btn-wpp"><%- WPP %> Entrar en el grupo de WhatsApp</a><% } %>
  </div></div>
<% } else if (!processo.inscricoes_abertas) { %>
  <div class="fechado-card"><h2>Inscripciones cerradas</h2><p>Las inscripciones para <strong><%= processo.nome %></strong> no están abiertas en este momento.<br><span style="color:var(--ink4)">Las inscripciones para este proceso están cerradas.</span></p></div>
<% } else { %>

<div class="banner-wrap">
  <% if(processo.banner_chave){ %>
    <img src="/pss/<%= processo.id %>/banner" style="width:100%;max-height:440px;object-fit:cover;display:block" alt="<%= processo.nome %>">
  <% } else { %>
    <div style="height:300px;background:linear-gradient(135deg,var(--p) 0%,color-mix(in srgb,var(--p) 55%,#000) 100%);display:flex;align-items:center;justify-content:center">
      <div style="width:72px;height:72px;border-radius:18px;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center"><svg style="width:36px;height:36px;fill:rgba(255,255,255,.55)" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg></div>
    </div>
  <% } %>
</div>

<div class="title-wrap"><div class="title-in">
  <div class="event-tag"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg> Liga Académica de Urología · Proceso Selectivo</div>
  <h1><%= processo.nome %></h1>
  <div class="title-meta">
    <% if(processo.data_prova){ %><div class="t-chip"><div class="t-chip-icon"><svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM5 8V6h14v2H5z"/></svg></div><span>Examen: <%= new Date(processo.data_prova).toLocaleDateString('es-ES',{day:'2-digit',month:'long',year:'numeric',timeZone:'UTC'}) %></span></div><% } %>
    <% if(processo.local_prova){ %><div class="t-chip"><div class="t-chip-icon"><svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1112 6.5a2.5 2.5 0 010 5z"/></svg></div><span><%= processo.local_prova %></span></div><% } %>
    <div class="t-chip"><div class="t-chip-icon"><svg viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg></div><span><%= _v>0 ? ('R$ '+_v.toFixed(2).replace('.',',')) : 'Gratuito' %></span></div>
  </div>
  <% if(processo.edital_chave){ %>
  <a href="/pss/<%= processo.id %>/edital" target="_blank" rel="noopener" class="edital-btn">
    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z"/></svg>
    <span class="lbl">Consultar el edital<small>Bases oficiales del proceso · PDF</small></span>
  </a>
  <% } %>
</div></div>

<% if(processo.wpp_grupo){ %>
<div class="wpp-banner"><div class="wpp-in">
  <div class="wpp-txt"><%- WPP %> Participá del grupo oficial en WhatsApp</div>
  <a href="<%= processo.wpp_grupo %>" target="_blank" class="wpp-join"><%- WPP %> Unirse al grupo</a>
</div></div>
<% } %>

<div class="wrap"><div class="grid">
  <div class="main">
    <% if(processo.descricao){ %>
    <div class="card">
      <div class="card-hd"><div class="card-hd-ic"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm-1 7V3.5L18.5 9H13z"/></svg></div><h2>Sobre el proceso</h2></div>
      <div class="card-bd" style="font-size:14px;line-height:1.85;color:var(--ink2);white-space:pre-line"><%= processo.descricao %></div>
    </div>
    <% } %>
    <div class="card" id="inscripcion">
      <div class="card-hd"><div class="card-hd-ic"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></div><h2>Formulario de inscripción</h2></div>
      <div class="card-bd">
        <% if (typeof erro !== 'undefined' && erro) { %><div class="erro-box"><%= erro %></div><% } %>
        <form method="POST" action="/pss/<%= processo.id %>/inscricao" onsubmit="var b=document.getElementById('bt');b.disabled=true;b.textContent='Procesando…'">
          <div class="campo"><label>Nombre completo / Nome completo <span class="req">*</span></label><input name="nome" class="inp" required maxlength="120" autocomplete="name"></div>
          <div class="grid2">
            <div class="campo"><label>Correo electrónico / E-mail <span class="req">*</span></label><input name="email" type="email" class="inp" required autocomplete="email"></div>
            <div class="campo"><label>WhatsApp <span class="req">*</span></label>
              <div class="doc-row">
                <select name="whatsapp_pais" class="inp" required><option value="+595">🇵🇾 +595</option><option value="+55">🇧🇷 +55</option><option value="+54">🇦🇷 +54</option><option value="+598">🇺🇾 +598</option><option value="+1">🇺🇸 +1</option></select>
                <input name="whatsapp" class="inp" inputmode="tel" required placeholder="99 999 9999" autocomplete="tel">
              </div>
            </div>
          </div>
          <div class="grid2">
            <div class="campo"><label>Fecha de nacimiento / Nascimento <span class="req">*</span></label><input name="data_nascimento" type="date" class="inp" required></div>
            <div class="campo"><label>Catraca UCP <span class="req">*</span></label><input name="catraca" class="inp" inputmode="numeric" required placeholder="Número de catraca"></div>
          </div>
          <div class="campo"><label>Documento <span class="req">*</span></label>
            <div class="doc-row"><select name="documento_tipo" class="inp"><option value="CPF">CPF</option><option value="CI">C.I.</option><option value="DNI">DNI</option></select><input name="documento" class="inp" required placeholder="Número del documento"></div>
          </div>
          <div class="grid2">
            <div class="campo"><label>Semestre <span class="req">*</span></label>
              <select name="semestre_atual" class="inp" required><option value="">Seleccione…</option><% for(let s=1;s<=12;s++){ %><option value="<%= s %>"><%= s %>º Semestre</option><% } %></select>
            </div>
            <div class="campo"><label>Turma <span class="req">*</span></label>
              <select name="turma" class="inp" required><option value="">Seleccione…</option><% 'ABCDEFGHIJ'.split('').forEach(function(t){ %><option value="<%= t %>">Turma <%= t %></option><% }) %></select>
            </div>
          </div>
          <div class="campo"><label>Cupón de descuento (opcional)</label><input name="cupom_codigo" class="inp cupom-in" value="<%= typeof cupomUrl!=='undefined'?cupomUrl:'' %>" placeholder="CÓDIGO"></div>
          <button class="btn-sub" id="bt" type="submit"><%= _v>0 ? 'Continuar al pago' : 'Confirmar inscripción' %></button>
          <div class="secure-note">Cada persona puede inscribirse una sola vez por proceso.</div>
        </form>
      </div>
    </div>
  </div>

  <div class="sidebar">
    <div class="resumo-card">
      <div class="resumo-eyebrow">Valor de la inscripción</div>
      <div class="resumo-nome"><%= processo.nome %></div>
      <div class="resumo-preco"><%= _v>0 ? ('R$ '+_v.toFixed(2).replace('.',',')) : 'Gratuito' %></div>
      <div class="resumo-divider"></div>
      <a href="#inscripcion" class="resumo-btn">Inscribirse ahora</a>
    </div>
    <div class="s-card">
      <div class="s-title">Información</div>
      <% if(processo.data_prova){ %><div class="info-it"><div class="i-icon"><svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM5 8V6h14v2H5z"/></svg></div><div><div class="i-lbl">Fecha del examen</div><div class="i-val"><%= new Date(processo.data_prova).toLocaleDateString('es-ES',{day:'2-digit',month:'long',year:'numeric',timeZone:'UTC'}) %></div></div></div><% } %>
      <% if(processo.local_prova){ %><div class="info-it"><div class="i-icon"><svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg></div><div><div class="i-lbl">Lugar</div><div class="i-val"><%= processo.local_prova %></div></div></div><% } %>
      <div class="info-it"><div class="i-icon"><svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg></div><div><div class="i-lbl">Dudas</div><div class="i-val">lauroucpcde@lauroucpcde.com</div></div></div>
    </div>
  </div>
</div></div>

<% } %>

<footer>
  <div class="foot-social">
