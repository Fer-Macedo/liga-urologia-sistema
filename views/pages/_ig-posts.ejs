        <!-- Publicações do Instagram: mesma classe .post-item, então entram no filtro e na busca -->
        <% var igp = (typeof igPosts !== 'undefined' && igPosts) ? igPosts : [];
           igp.forEach(function(g){
             var st = { agendado:['#fef3c7','#92400e','Agendado'], publicado:['#dcfce7','#166534','Publicado'], cancelado:['#e5e7eb','#4b5563','Cancelado'], erro:['#fee2e2','#991b1b','Erro'] }[g.status] || ['#eee','#555',g.status];
             var quando = g.publicado_em || g.agendado_para;
             var tp = { carousel:['#e0e7ff','#3730a3','Carrossel'], feed:['#d1fae5','#065f46','Post'], story:['#fce7f3','#9d174d','Story'], reel:['#ede9fe','#5b21b6','Reels'] }[g.tipo] || ['#e5e7eb','#374151', g.tipo];
             var tipoLbl = tp[2];
             var mid = []; try { mid = typeof g.midias === 'string' ? JSON.parse(g.midias) : (g.midias || []); } catch(e) {}
             if (!mid.length && g.midia_url) mid = [{url:g.midia_url}]; %>
        <div class="post-card post-item" data-status="<%=g.status%>" data-titulo="instagram <%=tipoLbl.toLowerCase()%> <%=(g.legenda||'').toLowerCase().substring(0,120)%>">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:10px">
            <div style="display:flex;align-items:center;gap:10px">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e1306c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="#e1306c" stroke="none"/></svg>
              <div>
                <div style="font-weight:700;font-size:14px">Instagram <%= mid.length>1 ? '· '+mid.length+' slides' : '' %></div>
                <div style="font-size:12px;color:var(--texto2)"><%= quando ? new Date(quando).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '-' %></div>
              </div>
            </div>
            <div style="display:flex;gap:6px;flex-shrink:0">
              <span class="badge" style="background:<%=tp[0]%>;color:<%=tp[1]%>"><%=tp[2]%></span>
              <span class="badge" style="background:<%=st[0]%>;color:<%=st[1]%>"><%=st[2]%></span>
            </div>
          </div>

          <% if (mid.length) { %>
          <div style="display:flex;gap:6px;overflow-x:auto;padding-bottom:6px;margin-bottom:10px">
            <% mid.forEach(function(m,ix){ %>
            <img src="<%=m.url%>" onclick="window.open('<%=m.url%>','_blank')" title="Slide <%=ix+1%> — clique para ampliar"
                 style="height:150px;border-radius:8px;border:1px solid var(--borda);cursor:pointer;flex-shrink:0">
            <% }); %>
          </div>
          <% } %>

          <div style="font-size:13px;color:var(--texto2);white-space:pre-wrap;line-height:1.5;background:var(--fundo);padding:10px 12px;border-radius:var(--rad);max-height:120px;overflow:auto" id="leg-<%=g.id%>"><%=g.legenda||''%></div>
          <% if (g.erro_msg) { %><div style="font-size:12px;color:#dc2626;margin-top:8px">Erro: <%=g.erro_msg%></div><% } %>

          <% if (g.status === 'agendado') { %>
          <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
            <button class="btn btn-sm" onclick="editarLegendaIG(<%=g.id%>)">Editar legenda</button>
            <button class="btn btn-sm" style="color:#dc2626" onclick="cancelarPostIG(<%=g.id%>)">Cancelar publicação</button>
          </div>
          <% } %>
        </div>
        <% }); %>
