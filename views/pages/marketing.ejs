var _canvaCarregado=false;
function canvaCarregarDesigns(){
  var grid=document.getElementById('canva-designs-grid');
  if(!grid) return;
  grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:20px;color:var(--texto2)">Carregando designs do Canva...</div>';
  fetch('/marketing/canva/designs').then(function(r){return r.json();}).then(function(d){
    if(!d.ok){grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:20px;color:#dc2626">'+(d.erro||'Erro ao carregar designs')+'</div>';return;}
    if(!d.designs.length){grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:20px;color:var(--texto2)">Nenhum design encontrado na conta Canva. Clique em "Criar novo design" para comecar.</div>';return;}
    grid.innerHTML=d.designs.map(function(des){
      var thumb=(des.thumbnail&&des.thumbnail.url)||'/img/placeholder.png';
      var titulo=des.title||'Sem titulo';
      var editUrl=des.urls&&des.urls.edit_url;
      return '<div class="midia-card">'
        +'<img src="'+thumb+'" alt="'+titulo+'" onerror="this.onerror=null;this.src=\'/img/placeholder.png\'">'
        +'<div class="midia-overlay" style="flex-direction:column;gap:6px;padding:8px">'
        +(editUrl?'<a href="'+editUrl+'" target="_blank" class="btn-xs" style="background:white;color:#111;text-decoration:none;width:100%;justify-content:center">Editar</a>':'')
        +'<button onclick="canvaImportar(\''+des.id+'\',\''+titulo.replace(/'/g,"\\'")+'\',this)" class="btn-xs" style="background:#0F6E56;color:white;border-color:transparent;width:100%;justify-content:center">Importar</button>'
        +'</div>'
        +'<div class="midia-card-info">'+titulo+'</div>'
        +'</div>';
    }).join('');
    _canvaCarregado=true;
  }).catch(function(){grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:20px;color:#dc2626">Erro ao carregar designs do Canva</div>';});
}
function previewWpp(texto){
  var p=document.getElementById('wpp-preview-text');
  if(p) p.textContent=texto||'Sua mensagem aparecera aqui...';
}
function usarTemplate(btn){
  var ta=document.getElementById('wpp-mensagem');
  if(!ta) return;
  ta.value=btn.textContent.trim();
  previewWpp(ta.value);
  ta.scrollIntoView({behavior:'smooth',block:'center'});
}
function canvaTogglePersonalizado(tipo){
  var mostrar=tipo==='Personalizado';
  document.getElementById('canva-largura').style.display=mostrar?'':'none';
  document.getElementById('canva-altura').style.display=mostrar?'':'none';
}
function canvaCriarDesign(){
  var tipo=document.getElementById('canva-tipo-novo').value;
  var largura=document.getElementById('canva-largura').value;
  var altura=document.getElementById('canva-altura').value;
  if(tipo==='Personalizado' && (!largura||!altura)){
    mostrarAviso('Informe largura e altura para o formato personalizado.','erro');
    return;
  }
  var win=window.open('','_blank'); // abre a aba na hora do clique, para o navegador nao bloquear como pop-up
  if(win) win.document.write('Abrindo o Canva...');
  fetch('/marketing/canva/criar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({tipo:tipo,largura:largura,altura:altura})})
    .then(function(r){return r.json();}).then(function(d){
      if(!d.ok){if(win)win.close(); mostrarAviso(d.erro||'Nao foi possivel criar o design.','erro');return;}
      if(d.editUrl && win) win.location.href=d.editUrl;
      else if(d.editUrl) window.open(d.editUrl,'_blank');
      setTimeout(canvaCarregarDesigns,1500);
    }).catch(function(){if(win)win.close(); mostrarAviso('Erro ao criar design no Canva.','erro');});
}
function canvaImportar(designId,titulo,btn){
  btn.disabled=true; btn.textContent='Importando...';
  fetch('/marketing/canva/importar/'+designId,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nome:titulo})})
    .then(function(r){return r.json();}).then(function(d){
      if(!d.ok){mostrarAviso(d.erro||'Nao foi possivel importar.','erro'); btn.disabled=false; btn.textContent='Importar'; return;}
      mostrarAviso('Design importado para a biblioteca de midias!','sucesso');
      setTimeout(function(){location.reload();},1200);
    }).catch(function(){mostrarAviso('Erro ao importar design.','erro'); btn.disabled=false; btn.textContent='Importar';});
}

// ─── FILTRO E BUSCA DOS POSTS ─────────────────────────────────────────────────
// Os cards já vinham com data-status/data-titulo, mas estas duas funções nunca
// existiram — por isso os botões Rascunhos/Agendados/Publicados não faziam nada.
function filtrarPosts(status, el){
  if(el){
    var grupo = el.parentNode;
    grupo.querySelectorAll('.pill').forEach(function(p){ p.classList.remove('ativo'); });
    el.classList.add('ativo');
  }
  document.querySelectorAll('.post-item').forEach(function(c){
    c.style.display = (status === 'todos' || c.dataset.status === status) ? '' : 'none';
  });
  var campo = document.querySelector('.search-bar input');
  if (campo) campo.value = '';
}
function buscarPost(termo){
  var t = (termo || '').toLowerCase().trim();
  document.querySelectorAll('.post-item').forEach(function(c){
    var texto = (c.dataset.titulo || '') + ' ' + (c.textContent || '').toLowerCase();
    c.style.display = (!t || texto.indexOf(t) >= 0) ? '' : 'none';
  });
}

// ─── BOTÕES QUE CHAMAVAM FUNÇÕES INEXISTENTES ────────────────────────────────
// editarPost / usarMidia / calcularMelhorHorario eram invocadas pelo HTML mas
// nunca haviam sido escritas — os botões simplesmente não faziam nada.

// Abre o modal de post já preenchido e aponta o formulário para a rota de edição
function editarPost(id){
  fetch('/marketing/'+id+'/dados').then(function(r){return r.json();}).then(function(d){
    if(!d.ok){ mostrarAviso(d.erro||'Não foi possível carregar o post.','erro'); return; }
    var m = document.getElementById('modal-novo-post');
    if(!m){ mostrarAviso('Formulário de post não encontrado.','erro'); return; }
    var f = m.querySelector('form');
    f.action = '/marketing/'+id+'/editar';
    if(f.titulo) f.titulo.value = d.post.titulo || '';
    if(f.conteudo) f.conteudo.value = d.post.conteudo || '';
    if(f.agendado_para && d.post.agendado_para){
      // datetime-local exige AAAA-MM-DDTHH:MM no horário local
      var dt = new Date(d.post.agendado_para);
      dt.setMinutes(dt.getMinutes() - dt.getTimezoneOffset());
      f.agendado_para.value = dt.toISOString().slice(0,16);
    }
    var tit = m.querySelector('.modal-titulo, h3, h2');
    if(tit) tit.textContent = 'Editar post';
    abrirModal('modal-novo-post');
  }).catch(function(){ mostrarAviso('Erro ao carregar o post.','erro'); });
}

// "Usar" na aba Mídias: abre o formulário de post já indicando a mídia escolhida
function usarMidia(id, nome){
  var m = document.getElementById('modal-novo-post');
  if(!m){ mostrarAviso('Formulário de post não encontrado.','erro'); return; }
  var f = m.querySelector('form');
  var campo = f.querySelector('input[name="midia_id"]');
  if(!campo){
    campo = document.createElement('input');
    campo.type = 'hidden'; campo.name = 'midia_id';
    f.appendChild(campo);
  }
  campo.value = id;
  var aviso = document.getElementById('midia-escolhida');
  if(!aviso){
    aviso = document.createElement('div');
    aviso.id = 'midia-escolhida';
    aviso.style.cssText = 'font-size:12px;color:var(--texto2);margin-top:6px';
    f.insertBefore(aviso, f.firstChild);
  }
  aviso.textContent = 'Mídia selecionada: ' + nome;
  abrirModal('modal-novo-post');
  mostrarAviso('Mídia "'+nome+'" selecionada para o post.','sucesso');
}

// Dica de horário ao escolher a data de agendamento
function calcularMelhorHorario(valor){
  var alvo = document.getElementById('dica-horario');
  if(!alvo){
    var campo = document.querySelector('input[name="agendado_para"]');
    if(!campo) return;
    alvo = document.createElement('div');
    alvo.id = 'dica-horario';
    alvo.style.cssText = 'font-size:11.5px;margin-top:5px';
    campo.parentNode.appendChild(alvo);
  }
  if(!valor){ alvo.textContent = ''; return; }
  var d = new Date(valor);
  if(isNaN(d)){ alvo.textContent = ''; return; }
  var h = d.getHours(), dia = d.getDay();
  var bom = (h >= 7 && h <= 9) || (h >= 11 && h <= 13) || (h >= 18 && h <= 21);
  var fds = (dia === 0 || dia === 6);
  if(bom && !fds){ alvo.style.color = '#16a34a'; alvo.textContent = '✓ Bom horário — seu público (25-34 anos) costuma estar ativo nesta faixa.'; }
  else if(fds){ alvo.style.color = '#d97706'; alvo.textContent = '⚠ Fim de semana costuma render menos alcance para conteúdo educativo.'; }
  else { alvo.style.color = '#d97706'; alvo.textContent = '⚠ Faixa de menor atividade. Melhores horários: 7h-9h, 11h-13h ou 18h-21h.'; }
}

