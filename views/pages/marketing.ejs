<script src="/js/app.js"></script>
<script>
const postsData=<%- JSON.stringify(posts).replace(/</g,"\u003c") %>;
const MESES_PT_JS=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
// showTab definida no head
function montarGrid(gridEl, tituloEl, mes, ano, itensPorDia, corDia){
  tituloEl.textContent=MESES_PT_JS[mes]+' '+ano;
  const hoje=new Date();
  const primeiroDia=new Date(ano,mes,1).getDay();
  const diasNoMes=new Date(ano,mes+1,0).getDate();
  const diasMesAnt=new Date(ano,mes,0).getDate();
  let html='';
  for(let i=0;i<42;i++){
    let dia,outroMes=false,mesRef=mes,anoRef=ano;
    if(i<primeiroDia){dia=diasMesAnt-primeiroDia+i+1;outroMes=true;mesRef=mes-1;if(mesRef<0){mesRef=11;anoRef--;}}
    else if(i>=primeiroDia+diasNoMes){dia=i-primeiroDia-diasNoMes+1;outroMes=true;mesRef=mes+1;if(mesRef>11){mesRef=0;anoRef++;}}
    else dia=i-primeiroDia+1;
    const isHoje=!outroMes&&dia===hoje.getDate()&&mes===hoje.getMonth()&&ano===hoje.getFullYear();
    const chave=anoRef+'-'+String(mesRef+1).padStart(2,'0')+'-'+String(dia).padStart(2,'0');
    const itens=outroMes?[]:(itensPorDia[chave]||[]);
    html+='<div class="cal-dia'+(isHoje?' hoje':'')+(outroMes?' outro-mes':'')+'"><div class="cal-num">'+dia+'</div>'+
      itens.map(it=>'<div class="cal-post" style="background:'+(it.cor||corDia)+'" title="'+it.titulo.replace(/"/g,'&quot;')+'">'+it.titulo+'</div>').join('')+'</div>';
  }
  gridEl.innerHTML=html;
}
const eventosInternosData=<%- JSON.stringify(eventosInternos).replace(/</g,"\\u003c") %>;
let calMesInt=new Date().getMonth(),calAnoInt=new Date().getFullYear();
function mudarMesInterno(d){calMesInt+=d;if(calMesInt<0){calMesInt=11;calAnoInt--;}if(calMesInt>11){calMesInt=0;calAnoInt++;}renderCalInterno();}
function renderCalInterno(){
  const porDia={};
  eventosInternosData.forEach(ev=>{
    const chave=ev.data_inicio.slice(0,10);
    (porDia[chave]=porDia[chave]||[]).push({titulo:ev.titulo,cor:ev.cor});
  });
  montarGrid(document.getElementById('cal-grid-interno'),document.getElementById('cal-titulo-interno'),calMesInt,calAnoInt,porDia,'#0F6E56');
}
renderCalInterno();
const hashtagsSel=new Set();
function calcScore(){
  const titulo=document.querySelector('[name="titulo"]')?.value||'';
  const conteudo=document.getElementById('post-conteudo')?.value||'';
  const imagem=document.querySelector('[name="imagem"]')?.files?.length>0;
  const redes=document.querySelectorAll('[name="redes"]:checked').length;
  const agendado=document.querySelector('[name="agendado_para"]')?.value;
  let score=0;const itens=[];
  if(titulo.length>5){score+=20;itens.push({ok:true,txt:'Titulo preenchido'});}else{itens.push({ok:false,txt:'Adicione um titulo'});}
  if(conteudo.length>30){score+=20;itens.push({ok:true,txt:'Legenda boa'});}else{itens.push({ok:false,txt:'Escreva uma legenda'});}
  if(conteudo.length>=100&&conteudo.length<=2200){score+=15;itens.push({ok:true,txt:'Tamanho ideal'});}else if(conteudo.length>0){itens.push({ok:false,txt:'Tamanho nao ideal'});}
  if(imagem){score+=20;itens.push({ok:true,txt:'Tem imagem'});}else{itens.push({ok:false,txt:'Adicione uma imagem'});}
  if(redes>0){score+=15;itens.push({ok:true,txt:redes+' rede(s)'});}else{itens.push({ok:false,txt:'Selecione redes'});}
  if(hashtagsSel.size>0){score+=10;itens.push({ok:true,txt:hashtagsSel.size+' hashtag(s)'});}else{itens.push({ok:false,txt:'Adicione hashtags'});}
  const cor=score>=70?'#10b981':score>=40?'#f59e0b':'#ef4444';
  document.getElementById('score-num').textContent=score;
  document.getElementById('score-num').style.color=cor;
  document.getElementById('score-fill').style.width=score+'%';
  document.getElementById('score-fill').style.background=cor;
  document.getElementById('score-itens').innerHTML=itens.map(i=>'<span class="score-item '+(i.ok?'ok':'no')+'">'+( i.ok?'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle"><polyline points="20 6 9 17 4 12"/></svg> ':' ')+i.txt+'</span>').join('');
}
document.addEventListener('input',e=>{if(e.target.closest('#modal-novo-post'))calcScore();});
document.addEventListener('change',e=>{if(e.target.closest('#modal-novo-post'))calcScore();});
async function gerarHashtags(){
  const titulo=document.querySelector('[name="titulo"]')?.value||'';
  const grid=document.getElementById('hashtag-grid');
  grid.innerHTML='<span style="font-size:12px;color:var(--texto2)">Gerando...</span>';
  try{
    const r=await fetch("/marketing/gerar-hashtags",{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({titulo})
    });
    const data=await r.json();
    if(!data.ok){grid.innerHTML='<span style="color:#dc2626;font-size:12px">'+(data.erro||'Erro ao gerar')+'</span>';return;}
    grid.innerHTML=data.tags.map(t=>'<span class="hashtag-chip" onclick="toggleHashtag(this,\''+t+'\')">'+t+'</span>').join('');
  }catch(e){grid.innerHTML='<span style="color:#dc2626;font-size:12px">Erro ao gerar</span>';}
}
function toggleHashtag(el,tag){
  el.classList.toggle('selecionado');
  if(el.classList.contains('selecionado'))hashtagsSel.add(tag);else hashtagsSel.delete(tag);
  document.getElementById('hashtags-selecionadas').value=[...hashtagsSel].join(' ');
  calcScore();
}
function usarTemplate2(titulo,conteudo){
  abrirModal('modal-novo-post');
  setTimeout(()=>{
    const t=document.querySelector('#modal-novo-post [name="titulo"]');
    const c=document.getElementById('post-conteudo');
    if(t)t.value=titulo;
    if(c){c.value=conteudo;atualizarPreview();calcScore();}
  },100);
}
function atualizarPreview(){
  const txt=document.getElementById('post-conteudo')?.value||'';
  const ig=document.getElementById('prev-ig-txt');
  const wpp=document.getElementById('prev-wpp-txt');
  if(ig)ig.textContent=txt.substring(0,150)+(txt.length>150?'...':'');
  if(wpp)wpp.textContent=txt.substring(0,200)+(txt.length>200?'...':'');
}
document.addEventListener('input',e=>{
  if(e.target.id==='post-conteudo')atualizarPreview();
});
function gerarRelatorio(){
  const linhas=[['Titulo','Status','Redes','Data']];
  postsData.forEach(p=>linhas.push([
    p.titulo||'(Sem titulo)',
    p.status,
    (p.redes||[]).join('/'),
    new Date(p.criado_em).toLocaleDateString('pt-BR')
  ]));
  const csv=linhas.map(l=>l.map(v=>'"'+(v||'').replace(/"/g,'""')+'"').join(',')).join('\n');
  const blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='relatorio-marketing.csv';
  a.click();
}
async function gerarComIA(){
  const titulo=document.querySelector('[name="titulo"]').value;
  const loading=document.getElementById('ia-loading');
  loading.classList.add('ativo');
  try{
    const r=await fetch("/marketing/gerar-legenda",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({titulo})});
    const data=await r.json();
    if(!data.ok){alert('Erro ao gerar com IA: '+(data.erro||'tente novamente')); loading.classList.remove('ativo'); return;}
    document.getElementById('post-conteudo').value=data.texto;
    atualizarPreview();
  }catch(e){alert('Erro ao gerar com IA. Tente novamente.');}
  loading.classList.remove('ativo');
}

// ─── INSTAGRAM FEED & COMENTARIOS ────────────────────────────────────────────
let igMediaAtual = null;

function igTab(tab) {
  document.getElementById('ig-tab-feed').style.display = tab === 'feed' ? 'block' : 'none';
  document.getElementById('ig-tab-config').style.display = tab === 'config' ? 'block' : 'none';
  const bf = document.getElementById('ig-btn-feed');
  const bc = document.getElementById('ig-btn-config');
  if(bf && bc) {
    bf.style.background = tab==='feed' ? '#833ab4' : '';
    bf.style.color = tab==='feed' ? 'white' : '';
    bc.style.background = tab==='config' ? '#833ab4' : '';
    bc.style.color = tab==='config' ? 'white' : '';
  }
}

function carregarIgPerfil() {
  fetch('/api/instagram/perfil').then(r=>r.json()).then(d=>{
    if(!d.ok) return;
    const p = d.perfil;
    const box = document.getElementById('ig-perfil-box');
    if(p.profile_picture_url) {
      box.querySelector('div').innerHTML = '<img src="'+p.profile_picture_url+'" class="ig-perfil-avatar">';
    }
    box.querySelector('div:nth-child(2) div:nth-child(2)').textContent = p.biography || '@lauroucp.cde';
    document.getElementById('ig-perfil-stats').innerHTML =
      '<div class="ig-perfil-stat"><div class="ig-perfil-stat-num">'+(p.followers_count||0)+'</div><div class="ig-perfil-stat-label">Seguidores</div></div>'+
      '<div class="ig-perfil-stat"><div class="ig-perfil-stat-num">'+(p.follows_count||0)+'</div><div class="ig-perfil-stat-label">Seguindo</div></div>'+
      '<div class="ig-perfil-stat"><div class="ig-perfil-stat-num">'+(p.media_count||0)+'</div><div class="ig-perfil-stat-label">Posts</div></div>';
  }).catch(()=>{});
}

function carregarIgFeed() {
  fetch('/api/instagram/feed').then(r=>r.json()).then(d=>{
    const grid = document.getElementById('ig-feed-grid');
    if(!d.ok || !d.feed.length) { grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:40px;color:#94a3b8">Nenhum post encontrado.</div>'; return; }
    grid.innerHTML = d.feed.map(p=>{
        const isVideo = p.media_type==='VIDEO'||p.media_type==='REELS';
        const isCarousel = p.media_type==='CAROUSEL_ALBUM';
        const imgSrc = isVideo ? (p.thumbnail_url||null) : p.media_url;
        let mediaHtml;
        if(imgSrc) {
          mediaHtml = '<div style="position:relative;flex-shrink:0">'
            +'<img src="'+imgSrc+'" class="ig-feed-img" onerror="this.parentNode.innerHTML=&quot;<div class=ig-feed-cover><svg width=36 height=36 viewBox=0 0 24 24 fill=none stroke=rgba(255,255,255,0.5) stroke-width=1.5><circle cx=12 cy=12 r=10/><path d=M9 9l6 3-6 3V9z/></svg></div>&quot;">'
            +(isVideo ? '<div style="position:absolute;top:8px;right:8px;background:rgba(0,0,0,.6);border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center"><svg width=12 height=12 viewBox=\'0 0 24 24\' fill=\'white\'><polygon points=\'5 3 19 12 5 21 5 3\'/></svg></div>' : '')
            +(isCarousel ? '<div style="position:absolute;top:8px;right:8px;background:rgba(0,0,0,.6);border-radius:4px;padding:2px 6px;font-size:10px;color:white;font-weight:700">+</div>' : '')
            +'</div>';
        } else {
          mediaHtml = '<div class="ig-feed-cover">'
            +'<svg width=36 height=36 viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9 9l6 3-6 3V9z"/></svg>'
            +'<span style="font-size:9px;color:rgba(255,255,255,0.4);font-weight:700;letter-spacing:1px;margin-top:2px">VIDEO</span>'
            +'</div>';
        }
        return `<div class="ig-feed-card" onclick="abrirComentarios('${p.id}')">
        ${mediaHtml}
        <div class="ig-feed-info">
          <div style="font-size:11px;color:#374151;line-height:1.4;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical">${p.caption||'(sem legenda)'}</div>
          <div>
            <div class="ig-feed-stats">
              <span>❤️ ${p.like_count||0}</span>
              <span>💬 ${p.comments_count||0}</span>
            </div>
            <div style="font-size:10px;color:#94a3b8;margin-top:4px">${new Date(p.timestamp).toLocaleDateString('pt-BR')}</div>
          </div>
        </div>
      </div>`;
      }).join('');
  }).catch(()=>{ document.getElementById('ig-feed-grid').innerHTML='<div style="grid-column:1/-1;text-align:center;padding:40px;color:#94a3b8">Erro ao carregar feed.</div>'; });
}

function abrirComentarios(mediaId) {
  igMediaAtual = mediaId;
  document.getElementById('modal-comentarios').classList.add('ativo');
  document.getElementById('comentarios-lista').innerHTML = '<div style="text-align:center;padding:20px;color:#94a3b8">Carregando...</div>';
  fetch('/api/instagram/comentarios/'+mediaId).then(r=>r.json()).then(d=>{
    if(!d.ok || !d.comentarios.length) {
      document.getElementById('comentarios-lista').innerHTML='<div style="text-align:center;padding:20px;color:#94a3b8">Nenhum comentario encontrado.</div>';
      return;
    }
    document.getElementById('comentarios-lista').innerHTML = (()=>{
    const avatarColors = ['#e11d48','#db2777','#9333ea','#7c3aed','#4f46e5','#2563eb','#0284c7','#0891b2','#059669','#16a34a','#ca8a04','#ea580c','#dc2626'];
    function getAvatarColor(u){let h=0;for(let i=0;i<(u||'u').length;i++)h+=(u||'u').charCodeAt(i);return avatarColors[h%avatarColors.length];}
    return d.comentarios.map(com=>{
      const uname = com.username||'usuario';
      const initials = uname.substring(0,2).toUpperCase();
      const color = getAvatarColor(uname);
      const igUrl = 'https://www.instagram.com/'+uname;
      const repliesHtml = com.replies&&com.replies.data&&com.replies.data.length
        ? com.replies.data.map(r=>{
            const rn=r.username||'lauro';
            return `<div style="display:flex;gap:8px;align-items:flex-start;margin-top:8px;margin-left:46px;background:#f8fafc;border-radius:8px;padding:8px 10px;border-left:3px solid #1a3d2b">
              <div class="com-avatar" style="width:28px;height:28px;font-size:10px;background:${getAvatarColor(rn)};flex-shrink:0">${rn.substring(0,2).toUpperCase()}</div>
              <div><a href="https://www.instagram.com/${rn}" target="_blank" style="font-weight:700;font-size:12px;color:#1a3d2b;text-decoration:none">@${rn}</a>
              <div style="font-size:12px;color:#374151;margin-top:2px">${r.text}</div>
              <div style="font-size:10px;color:#94a3b8;margin-top:2px">${new Date(r.timestamp).toLocaleString('pt-BR')}</div></div></div>`;
          }).join('') : '';
      return `<div class="com-item">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
          <div style="display:flex;gap:10px;align-items:flex-start;flex:1;min-width:0">
            <a href="${igUrl}" target="_blank" title="Ver perfil no Instagram" style="flex-shrink:0">
              <div class="com-avatar" style="background:${color}">${initials}</div>
            </a>
            <div style="flex:1;min-width:0">
              <a href="${igUrl}" target="_blank" style="text-decoration:none">
                <div class="com-username" style="display:flex;align-items:center;gap:5px">
                  @${uname}
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </div>
              </a>
              <div class="com-texto">${com.text}</div>
              <div class="com-data">${new Date(com.timestamp).toLocaleString('pt-BR')}</div>
            </div>
          </div>
          <button onclick="mostrarResposta('${com.id}')" style="background:#f1f5f9;border:none;border-radius:6px;padding:5px 10px;cursor:pointer;font-size:12px;font-weight:600;white-space:nowrap;display:flex;align-items:center;gap:4px;flex-shrink:0">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Responder
          </button>
        </div>
        <div id="form-resposta-${com.id}" style="display:none;margin-top:8px;margin-left:48px">
          <textarea id="texto-resposta-${com.id}" placeholder="Digite sua resposta..." style="width:100%;padding:8px;border:1px solid #e2e8f0;border-radius:6px;font-size:12px;resize:vertical;min-height:50px;box-sizing:border-box"></textarea>
          <div style="display:flex;gap:6px;margin-top:6px">
            <button onclick="enviarRespostaComentario('${com.id}')" style="background:#1a3d2b;color:white;border:none;border-radius:6px;padding:6px 14px;cursor:pointer;font-size:12px;font-weight:600;display:flex;align-items:center;gap:4px">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Enviar
            </button>
            <button onclick="document.getElementById('form-resposta-${com.id}').style.display='none'" style="background:#f1f5f9;border:none;border-radius:6px;padding:6px 14px;cursor:pointer;font-size:12px">Cancelar</button>
          </div>
        </div>
        ${repliesHtml}
      </div>`;
    }).join('');
  })();
  }).catch(()=>{ document.getElementById('comentarios-lista').innerHTML='<div style="color:#ef4444;padding:16px">Erro ao carregar comentarios.</div>'; });
}

function mostrarResposta(comId) {
  const form = document.getElementById('form-resposta-'+comId);
  form.style.display = form.style.display === 'none' ? 'block' : 'none';
}

function fecharComentarios() {
  document.getElementById('modal-comentarios').classList.remove('ativo');
  igMediaAtual = null;
}

function enviarRespostaComentario(comId) {
  const texto = document.getElementById('texto-resposta-'+comId).value.trim();
  if(!texto) return;
  fetch('/api/instagram/comentarios/'+comId+'/responder', {
    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({texto})
  }).then(r=>r.json()).then(d=>{
    if(d.ok) { document.getElementById('form-resposta-'+comId).style.display='none'; abrirComentarios(igMediaAtual); }
    else alert('Erro ao enviar resposta.');
  });
}

