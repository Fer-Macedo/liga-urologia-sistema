            <%aniversariantesHoje.forEach(function(p){%>
            <a href="/marketing/aniversario/preview/<%=p.tipo%>/<%=p.id%>" target="_blank" class="btn-xs" style="background:var(--card);border:1px solid var(--borda)"><%=p.nome%> (<%=p.tipo%>)</a>
            <%});%>
          </div>
          <%}%>
        </div>
