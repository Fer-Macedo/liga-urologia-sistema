<div class="modal-overlay" id="modal-evento-interno" style="display:none">
  <div class="modal">
    <div class="modal-header"><span class="modal-titulo">Nova atividade</span><button class="icon-btn" onclick="fecharModal('modal-evento-interno')">&#x2715;</button></div>
