                <input type="text" id="aniv-nome-manual" class="input" placeholder="Deixe em branco para automatico">
              </div>
              <button type="submit" class="btn btn-primario btn-sm">Testar previa</button>
              <button type="button" class="btn btn-secundario btn-sm" onclick="var u=anivMontarUrl(true); if(u) window.open(u,'_blank');">Baixar imagem</button>
            </form>
            <label style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--texto2);margin-top:10px">
              <input type="checkbox" id="aniv-nome-completo"> Usar nome completo (por padrao, sem campo manual, usa so primeiro + ultimo nome pra nao estourar a arte)
            </label>
            <div style="font-size:11px;color:var(--texto2);margin-top:8px">Use "Baixar imagem" para salvar o arquivo e postar tambem no grupo interno de WhatsApp no dia do aniversario.</div>
          </div>
          <%}%>

          <%if(aniversarioTemplateUrl && aniversariantesHoje.length){%>
          <div style="font-size:12px;color:var(--texto2);margin-bottom:8px">Aniversariantes de hoje (previa da arte, sem publicar):</div>
