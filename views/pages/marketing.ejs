            <script>
              function anivMontarUrl(download){
                var s=document.getElementById('aniv-teste-select');
                var nomeManual=document.getElementById('aniv-nome-manual').value.trim();
                var usarCompleto=document.getElementById('aniv-nome-completo').checked;
                if(!s.value) return null;
                var url='/marketing/aniversario/preview/'+s.value+'?';
                if(nomeManual) url+='nome='+encodeURIComponent(nomeManual);
                else if(usarCompleto) url+='nome_completo=1';
                if(download) url+='&download=1';
                return url;
              }
            </script>
            <form onsubmit="var u=anivMontarUrl(false); if(u) window.open(u,'_blank'); return false;" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end">
