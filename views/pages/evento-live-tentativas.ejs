<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <link rel="shortcut icon" href="/favicon.ico"><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tentativas de acesso — <%= insc.nome %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin-modern.css">
  <link rel="stylesheet" href="/css/tema-lauro.css">
  <style>
    :root { --cor-primaria: <%= config.org_cor || '#1a56db' %>; }
    .table-moderna { background:var(--card);border:1px solid var(--borda);border-radius:14px;overflow:hidden; }
    .table-moderna table { width:100%;border-collapse:collapse; }
    .table-moderna thead th { background:var(--fundo);padding:11px 14px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--texto2);text-align:left;border-bottom:1px solid var(--borda); }
    .table-moderna tbody tr { border-bottom:1px solid var(--borda); }
    .table-moderna tbody tr:last-child { border-bottom:none; }
    .table-moderna tbody td { padding:12px 14px;font-size:13px;color:var(--texto);vertical-align:middle; }
    .badge-apt { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700; }
    .badge-apt.apto   { background:#dcfce7;color:#166534; }
    .badge-apt.inapto { background:#fee2e2;color:#991b1b; }
    .info-box { background:var(--card);border:1px solid var(--borda);border-radius:14px;padding:16px 20px;margin-bottom:20px;font-size:13px;color:var(--texto2); }
    .info-box strong { color:var(--texto); }
  </style>
</head>
<body>
<div class="layout">
  <%- include('../partials/sidebar', { paginaAtual: 'eventos' }) %>
  <main class="main">
    <div class="topbar">
      <h1 class="page-titulo">Tentativas de acesso — <%= insc.nome %></h1>
      <div class="topbar-acoes">
        <a href="/eventos/<%= evento.id %>/presencas" class="btn btn-sm">Voltar</a>
      </div>
    </div>
    <div class="content">
      <div class="info-box">
        <div><strong>E-mail cadastrado na inscrição:</strong> <%= insc.email %></div>
        <% if (presenca) { %>
          <div style="margin-top:6px"><strong>Primeiro acesso ao link:</strong> <%= presenca.primeiro_acesso ? new Date(presenca.primeiro_acesso).toLocaleString('pt-BR') : '—' %></div>
          <div style="margin-top:6px"><strong>Último carregamento da página:</strong> <%= presenca.ultimo_ping ? new Date(presenca.ultimo_ping).toLocaleString('pt-BR') : '—' %></div>
        <% } else { %>
          <div style="margin-top:6px">Esta pessoa nunca abriu o link de acesso à live deste evento.</div>
        <% } %>
      </div>

      <div class="table-moderna">
        <table>
          <thead>
            <tr>
              <th>Data/hora</th>
              <th>E-mail digitado</th>
              <th>Resultado</th>
              <th>IP</th>
            </tr>
          </thead>
          <tbody>
            <% if (!tentativas.length) { %>
              <tr><td colspan="4" style="text-align:center;color:var(--texto2);padding:24px">Nenhuma tentativa de acesso registrada.</td></tr>
            <% } %>
            <% tentativas.forEach(function(t){ %>
            <tr>
              <td><%= new Date(t.criado_em).toLocaleString('pt-BR') %></td>
              <td><%= t.email_digitado || '—' %></td>
              <td>
                <% if (t.sucesso) { %>
                  <span class="badge-apt apto">Bateu com a inscrição</span>
                <% } else { %>
                  <span class="badge-apt inapto">Não bateu</span>
                <% } %>
              </td>
              <td><%= t.ip || '—' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
